{
  "version": 1,
  "meta": {
    "id": "vercel",
    "title": "Vercel",
    "category": "Developer Tools",
    "summary": "Frontend deployment. Black and white precision, Geist font.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#171717",
    "slate": "#4d4d4d",
    "signal": "#ff5b4f",
    "bone": "#ffffff",
    "border": "#ebebeb",
    "surface": "#ffffff",
    "extended": {
      "true-black": "#000000",
      "preview-pink": "#de1d8d",
      "develop-blue": "#0a72ef",
      "console-blue": "#0070f3",
      "console-purple": "#7928ca",
      "console-pink": "#eb367f",
      "link-blue": "#0072f5",
      "gray-500": "#666666",
      "gray-400": "#808080",
      "gray-50": "#fafafa",
      "badge-blue-bg": "#ebf5ff",
      "badge-blue-text": "#0068d6"
    },
    "semantic": {
      "danger": "#ff5b4f",
      "info": "#0a72ef"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "Geist Mono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "ui",
        "size": "48px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "-2.4px"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "40px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "-2.4px"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "ui",
        "size": "32px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "-1.28px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "ui",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-1.28px"
      },
      {
        "role": "Card Title",
        "fontKey": "ui",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "-0.96px"
      },
      {
        "role": "Card Title Light",
        "fontKey": "ui",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "-0.96px"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.80",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.56",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Semibold",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "-0.32px"
      },
      {
        "role": "Button / Link",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Button Small",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Mono Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Mono Caption",
        "fontKey": "mono",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.54",
        "letterSpacing": "0"
      },
      {
        "role": "Mono Small",
        "fontKey": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Badge",
        "fontKey": "ui",
        "size": "7px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "3px",
      "s-4": "4px",
      "s-5": "5px",
      "s-6": "6px",
      "s-7": "8px",
      "s-8": "10px",
      "s-9": "12px",
      "s-10": "14px",
      "s-11": "16px",
      "s-12": "32px",
      "s-13": "36px",
      "s-14": "40px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "64px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus (Accessibility)",
      "treatment": "2px solid hsla(212, 100%, 48%, 1) outline"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
