{
  "version": 1,
  "meta": {
    "id": "webflow",
    "title": "Webflow",
    "category": "Design & Creative",
    "summary": "Visual web builder. Blue-accented, polished marketing site aesthetic.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#080808",
    "slate": "#ababab",
    "signal": "#146ef5",
    "bone": "#f5f5f5",
    "border": "#d8d8d8",
    "surface": "#f5f5f5",
    "extended": {
      "blue-400": "#3b89ff",
      "blue-300": "#006acc",
      "button-hover-blue": "#0055d4",
      "purple": "#7a3dff",
      "pink": "#ed52cb",
      "green": "#00d722",
      "orange": "#ff6b00",
      "yellow": "#ffae13",
      "red": "#ee1d36",
      "gray-800": "#222222",
      "gray-700": "#363636",
      "mid-gray": "#5a5a5a",
      "border-hover": "#898989"
    },
    "semantic": {
      "success": "#00d722",
      "warning": "#ffae13",
      "danger": "#ee1d36",
      "info": "#146ef5"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "80px",
        "weight": 600,
        "lineHeight": "1.04",
        "letterSpacing": "-0.8px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "56px",
        "weight": 600,
        "lineHeight": "1.04",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "32px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "display",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body Standard",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.60",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Uppercase Label",
        "fontKey": "ui",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "1.5px"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Badge Uppercase",
        "fontKey": "mono",
        "size": "12.8px",
        "weight": 550,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Uppercase",
        "fontKey": "body",
        "size": "10px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "1px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "2px",
    "md": "6px",
    "lg": "24px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "6px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "6px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
