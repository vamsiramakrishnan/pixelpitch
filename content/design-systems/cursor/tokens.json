{
  "version": 1,
  "meta": {
    "id": "cursor",
    "title": "Cursor",
    "category": "Developer Tools",
    "summary": "AI-first code editor. Sleek dark interface, gradient accents.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f2f1ed",
    "ink": "#26251e",
    "slate": "#666666",
    "signal": "#f54e00",
    "bone": "#e6e5e0",
    "border": "#e5e5e5",
    "surface": "#e6e5e0",
    "extended": {
      "pure-white": "#ffffff",
      "true-black": "#000000",
      "gold": "#c08532",
      "error": "#cf2d56",
      "success": "#1f8a65",
      "thinking": "#dfa88f",
      "grep": "#9fc9a2",
      "read": "#9fbbe0",
      "edit": "#c0a8dd",
      "surface-100": "#f7f7f4",
      "surface-300": "#ebeae5",
      "surface-500": "#e1e0db"
    },
    "semantic": {
      "success": "#1f8a65",
      "warning": "#26251e",
      "danger": "#cf2d56",
      "info": "#9fbbe0"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "72px",
        "weight": 400,
        "lineHeight": "1.10",
        "letterSpacing": "-2.16px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-0.72px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "26px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "-0.325px"
      },
      {
        "role": "Title Small",
        "fontKey": "body",
        "size": "22px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.11px"
      },
      {
        "role": "Body Serif",
        "fontKey": "body",
        "size": "19.2px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Serif SM",
        "fontKey": "body",
        "size": "17.28px",
        "weight": 400,
        "lineHeight": "1.35",
        "letterSpacing": "0"
      },
      {
        "role": "Body Sans",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.08px"
      },
      {
        "role": "Button Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Button Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.14px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "System Heading",
        "fontKey": "display",
        "size": "20px",
        "weight": 700,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      {
        "role": "System Caption",
        "fontKey": "display",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "System Micro",
        "fontKey": "display",
        "size": "11px",
        "weight": 500,
        "lineHeight": "1.27",
        "letterSpacing": "0.048px"
      },
      {
        "role": "Mono Body",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.67",
        "letterSpacing": "0"
      },
      {
        "role": "Mono Small",
        "fontKey": "mono",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "-0.275px"
      },
      {
        "role": "Lato Heading",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Lato Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Lato Micro",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.27",
        "letterSpacing": "0.053px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "2px",
    "md": "8px",
    "lg": "120px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus",
      "treatment": "rgba(0,0,0,0.1) 0px 4px 12px on button focus"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
