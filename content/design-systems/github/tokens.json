{
  "version": 1,
  "meta": {
    "id": "github",
    "title": "GitHub",
    "category": "Developer Tools",
    "summary": "Code-forward platform. Functional density, blue-on-white precision, Primer foundations.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#1f2328",
    "slate": "#656d76",
    "signal": "#0969da",
    "bone": "#f6f8fa",
    "border": "#d0d7de",
    "surface": "#f6f8fa",
    "extended": {
      "github-green": "#1a7f37",
      "canvas-inset": "#eaeef2",
      "primer-blue-hover": "#0550ae",
      "accent-subtle": "#ddf4ff",
      "success-subtle": "#dafbe1",
      "closed-danger-red": "#cf222e",
      "danger-subtle": "#ffebe9",
      "attention-warning-yellow": "#9a6700",
      "attention-subtle": "#fff8c5",
      "done-purple": "#8250df",
      "sponsor-pink": "#bf3989",
      "border-muted": "#d8dee4",
      "dark-canvas": "#0d1117",
      "dark-surface": "#161b22",
      "dark-border": "#30363d",
      "dark-fg": "#e6edf3"
    },
    "semantic": {
      "success": "#0969da",
      "warning": "#9a6700",
      "danger": "#cf222e",
      "info": "#ddf4ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display",
        "fontKey": "display",
        "size": "32px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "H1",
        "fontKey": "display",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "H2",
        "fontKey": "display",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "H3",
        "fontKey": "display",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "display",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "display",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.4",
        "letterSpacing": "0"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
