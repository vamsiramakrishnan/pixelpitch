      {
        "role": "Code Label",
        "fontKey": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": "2.00",
        "letterSpacing": "0"
      },
      {
        "role": "Code Micro",
        "fontKey": "mono",
        "size": "9px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
