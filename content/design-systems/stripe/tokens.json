  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "6px",
      "s-5": "8px",
      "s-6": "10px",
      "s-7": "11px",
      "s-8": "12px",
      "s-9": "14px",
      "s-10": "16px",
      "s-11": "18px",
      "s-12": "20px"
