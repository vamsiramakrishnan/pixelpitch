{
  "version": 1,
  "meta": {
    "id": "mastercard",
    "title": "Mastercard",
    "category": "Fintech & Crypto",
    "summary": "Global payments network. Warm cream canvas, orbital pill shapes, editorial warmth.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f3f0ee",
    "ink": "#141413",
    "slate": "#696969",
    "signal": "#555555",
    "bone": "#f4f4f4",
    "border": "#e5e5e5",
    "surface": "#eb001b",
    "extended": {
      "mastercard-yellow": "#f79e1b",
      "signal-orange": "#cf4500",
      "light-signal-orange": "#f37338",
      "clay-brown": "#9a3a0a",
      "lifted-cream": "#fcfbfa",
      "white": "#ffffff",
      "charcoal": "#262627",
      "graphite": "#565656",
      "dust-taupe": "#d1cdc7",
      "link-blue": "#3860be"
    },
    "semantic": {
      "warning": "#f79e1b",
      "danger": "#eb001b",
      "info": "#3860be"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "H1 (hero)",
        "fontKey": "display",
        "size": "64px",
        "weight": 500,
        "lineHeight": "64",
        "letterSpacing": "-1.28px"
      },
      {
        "role": "H2 (section)",
        "fontKey": "body",
        "size": "36px",
        "weight": 500,
        "lineHeight": "44",
        "letterSpacing": "-0.72px"
      },
      {
        "role": "H3 (card title)",
        "fontKey": "display",
        "size": "24px",
        "weight": 500,
        "lineHeight": "28.8",
        "letterSpacing": "-0.48px"
      },
      {
        "role": "H4 (subhead)",
        "fontKey": "body",
        "size": "14px",
        "weight": 700,
        "lineHeight": "18.2",
        "letterSpacing": "0"
      },
      {
        "role": "Eyebrow (H5)",
        "fontKey": "body",
        "size": "14px",
        "weight": 700,
        "lineHeight": "14",
        "letterSpacing": "0.56px"
      },
      {
        "role": "Body paragraph",
        "fontKey": "body",
        "size": "16px",
        "weight": 450,
        "lineHeight": "22.4",
        "letterSpacing": "0"
      },
      {
        "role": "Nav link / Button label",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "16",
        "letterSpacing": "-0.48px"
      },
      {
        "role": "Footer link",
        "fontKey": "body",
        "size": "14px",
        "weight": 450,
        "lineHeight": "20",
        "letterSpacing": "0"
      },
      {
        "role": "Footer column header",
        "fontKey": "body",
        "size": "14px",
        "weight": 700,
        "lineHeight": "14",
        "letterSpacing": "0.56px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "64px",
    "lg": "16px",
    "full": "1000px"
  },
  "depth": [
    {
      "level": 0,
      "name": "0",
      "treatment": "No shadow"
    },
    {
      "level": 1,
      "name": "1",
      "treatment": "rgba(0, 0, 0, 0.04) 0px 4px 24px 0px"
    },
    {
      "level": 2,
      "name": "2",
      "treatment": "rgba(0, 0, 0, 0.08) 0px 24px 48px 0px"
    },
    {
      "level": 3,
      "name": "3",
      "treatment": "rgba(0, 0, 0, 0.25) 0px 70px 110px 0px"
    }
  ],
  "components": {
    "buttonRadius": "40px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "64px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
