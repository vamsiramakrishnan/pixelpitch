{
  "version": 1,
  "meta": {
    "id": "lovable",
    "title": "Lovable",
    "category": "Developer Tools",
    "summary": "AI full-stack builder. Playful gradients, friendly dev aesthetic.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f7f4ed",
    "ink": "#1c1c1c",
    "slate": "#5f5f5d",
    "signal": "#5f5f5d",
    "bone": "#f7f4ed",
    "border": "#eceae4",
    "surface": "#f7f4ed",
    "extended": {
      "off-white": "#fcfbf8",
      "ring-blue": "#3b82f6"
    },
    "semantic": {
      "info": "#3b82f6"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "60px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "-1.5px"
      },
      {
        "role": "Display Alt",
        "fontKey": "body",
        "size": "60px",
        "weight": 480,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "-1.2px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "-0.9px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.38",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button Small",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Link",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Link Small",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "8px",
      "s-2": "10px",
      "s-3": "12px",
      "s-4": "16px",
      "s-5": "24px",
      "s-6": "32px",
      "s-7": "40px",
      "s-8": "56px",
      "s-9": "80px",
      "s-10": "96px",
      "s-11": "128px",
      "s-12": "176px",
      "s-13": "192px",
      "s-14": "208px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "32px",
    "md": "8px",
    "lg": "80px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Ring (Accessibility)",
      "treatment": "rgba(59,130,246,0.5) 2px ring"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
