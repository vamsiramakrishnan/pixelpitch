{
  "version": 1,
  "meta": {
    "id": "sanity",
    "title": "Sanity",
    "category": "Backend & Data",
    "summary": "Headless CMS. Red accent, content-first editorial layout.",
    "surface": "web"
  },
  "colors": {
    "paper": "#55beff",
    "ink": "#0052ef",
    "slate": "#b9b9b9",
    "signal": "#f36458",
    "bone": "#212121",
    "border": "#000000",
    "surface": "#212121",
    "extended": {
      "sanity-black": "#0b0b0b",
      "medium-dark": "#353535",
      "pure-white": "#ffffff",
      "light-gray": "#ededed",
      "medium-gray": "#797979",
      "error-red": "#dd0000",
      "gpc-green": "#37cd84"
    },
    "semantic": {
      "success": "#37cd84",
      "warning": "#dd0000",
      "danger": "#dd0000",
      "info": "#0052ef"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "112px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-4.48px"
      },
      {
        "role": "Hero Secondary",
        "fontKey": "body",
        "size": "72px",
        "weight": 400,
        "lineHeight": "1.05",
        "letterSpacing": "-2.88px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.08",
        "letterSpacing": "-1.68px"
      },
      {
        "role": "Heading Large",
        "fontKey": "body",
        "size": "38px",
        "weight": 400,
        "lineHeight": "1.10",
        "letterSpacing": "-1.14px"
      },
      {
        "role": "Heading Medium",
        "fontKey": "body",
        "size": "32px",
        "weight": 425,
        "lineHeight": "1.24",
        "letterSpacing": "-0.32px"
      },
      {
        "role": "Heading Small",
        "fontKey": "body",
        "size": "24px",
        "weight": 425,
        "lineHeight": "1.24",
        "letterSpacing": "-0.24px"
      },
      {
        "role": "Subheading",
        "fontKey": "body",
        "size": "20px",
        "weight": 425,
        "lineHeight": "1.13",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.18px"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.15px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.13px"
      },
      {
        "role": "Small Caption",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.12px"
      },
      {
        "role": "Micro / Label",
        "fontKey": "body",
        "size": "11px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Code Caption",
        "fontKey": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Code Micro",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "99999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
