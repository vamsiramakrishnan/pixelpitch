{
  "version": 1,
  "meta": {
    "id": "composio",
    "title": "Composio",
    "category": "Backend & Data",
    "summary": "Tool integration platform. Modern dark with colorful integration icons.",
    "surface": "web"
  },
  "colors": {
    "paper": "#0f0f0f",
    "ink": "#111111",
    "slate": "#666666",
    "signal": "#00ffff",
    "bone": "#000000",
    "border": "#0089ff",
    "surface": "#00ffff",
    "extended": {
      "composio-cobalt": "#0007cd",
      "accessible-brand-blue": "#8859ff",
      "ocean-blue": "#0096ff",
      "charcoal": "#2c2c2c",
      "pure-white": "#ffffff",
      "muted-smoke": "#7b7b7b",
      "light-border": "#e0e0e0"
    },
    "semantic": {
      "danger": "#0f0f0f",
      "info": "#0007cd"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "JetBrains Mono",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "64px",
        "weight": 400,
        "lineHeight": "0.87",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "body",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "28px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Label",
        "fontKey": "body",
        "size": "20px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.63",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.63",
        "letterSpacing": "0"
      },
      {
        "role": "Label",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Tag / Overline",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.32px"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.28px"
      },
      {
        "role": "Code Caption",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.28px"
      },
      {
        "role": "Code Overline",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0.7px"
      },
      {
        "role": "Code Micro",
        "fontKey": "mono",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0.55px"
      },
      {
        "role": "Code Nano",
        "fontKey": "mono",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0.45-0.5px"
      }
    ],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "6px",
      "s-5": "8px",
      "s-6": "10px",
      "s-7": "12px",
      "s-8": "14px",
      "s-9": "16px",
      "s-10": "18px",
      "s-11": "20px",
      "s-12": "24px",
      "s-13": "30px",
      "s-14": "32px",
      "s-15": "40px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "120px",
    "full": "37px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
