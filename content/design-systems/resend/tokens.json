{
  "version": 1,
  "meta": {
    "id": "resend",
    "title": "Resend",
    "category": "Productivity & SaaS",
    "summary": "Email API. Minimal dark theme, monospace accents.",
    "surface": "web"
  },
  "colors": {
    "paper": "#000000",
    "ink": "#f0f0f0",
    "slate": "#a1a4a5",
    "signal": "#ff801f",
    "bone": "#ff5900",
    "border": "#eaeaea",
    "surface": "#f8f8f8",
    "extended": {
      "pure-white": "#ffffff",
      "orange-11": "#ffa057",
      "green-3": "#22ff99",
      "green-4": "#11ff99",
      "blue-4": "#0075ff",
      "blue-5": "#0081fd",
      "blue-10": "#3b9eff",
      "yellow-9": "#ffc53d",
      "red-5": "#ff2047",
      "dark-gray": "#707578",
      "mid-gray": "#5c5c5c",
      "medium-gray": "#494949",
      "edge-gray": "#ececec",
      "mist-gray": "#dedfdf",
      "soft-gray": "#e5e6e6",
      "frost-primary": "#fcfdff"
    },
    "semantic": {
      "success": "#11ff99",
      "warning": "#ffc53d",
      "danger": "#ff2047",
      "info": "#0075ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "commitMono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "96px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.96px"
      },
      {
        "role": "Display Hero Mobile",
        "fontKey": "body",
        "size": "76.8px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.768px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "56px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-2.8px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading Compact",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.8px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Semibold",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Link",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.43",
        "letterSpacing": "0.35px"
      },
      {
        "role": "Button / Link",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Helvetica Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Small Uppercase",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Small Capitalize",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Code Tiny",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Heading (Helvetica)",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "5px",
      "s-5": "6px",
      "s-6": "7px",
      "s-7": "8px",
      "s-8": "10px",
      "s-9": "12px",
      "s-10": "16px",
      "s-11": "20px",
      "s-12": "24px",
      "s-13": "30px",
      "s-14": "32px",
      "s-15": "40px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "10px",
    "lg": "80px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "24px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
