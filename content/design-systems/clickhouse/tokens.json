{
  "version": 1,
  "meta": {
    "id": "clickhouse",
    "title": "ClickHouse",
    "category": "Backend & Data",
    "summary": "Fast analytics database. Yellow-accented, technical documentation style.",
    "surface": "web"
  },
  "colors": {
    "paper": "#000000",
    "ink": "#ffffff",
    "slate": "#a0a0a0",
    "signal": "#faff69",
    "bone": "#161600",
    "border": "#faff69",
    "surface": "#414141",
    "extended": {
      "forest-green": "#166534",
      "dark-forest": "#14572f",
      "pale-yellow": "#f4f692",
      "border-olive": "#4f5100",
      "near-black": "#141414",
      "deep-charcoal": "#343434",
      "hover-gray": "#3a3a3a",
      "mid-gray": "#585858",
      "border-gray": "#e5e7eb"
    },
    "semantic": {
      "success": "#faff69",
      "warning": "#faff69"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "Inconsolata",
    "ramp": [
      {
        "role": "Display Mega",
        "fontKey": "body",
        "size": "96px",
        "weight": 900,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "72px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 600,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.17",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.56",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Uppercase Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.43",
        "letterSpacing": "1.4px"
      },
      {
        "role": "Code",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "11.2px",
        "weight": 500,
        "lineHeight": "1.79",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "6px",
      "s-3": "7px",
      "s-4": "8px",
      "s-5": "10px",
      "s-6": "12px",
      "s-7": "16px",
      "s-8": "20px",
      "s-9": "24px",
      "s-10": "25px",
      "s-11": "32px",
      "s-12": "40px",
      "s-13": "44px",
      "s-14": "48px",
      "s-15": "64px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "64px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
