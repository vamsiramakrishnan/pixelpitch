{
  "version": 1,
  "meta": {
    "id": "slack",
    "title": "Slack",
    "category": "Productivity & SaaS",
    "summary": "Workplace messaging platform. Aubergine personality, four-color brand system, workspace-first UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#4a154b",
    "ink": "#1d1c1d",
    "slate": "#868686",
    "signal": "#611f69",
    "bone": "#f8f8f8",
    "border": "#dddddd",
    "surface": "#ffffff",
    "extended": {
      "aubergine-deepest": "#1a0421",
      "slack-blue": "#36c5f0",
      "slack-green": "#2eb67d",
      "slack-yellow": "#ecb22e",
      "slack-red": "#e01e5a",
      "light-gray": "#f4ede4",
      "secondary-text": "#616061",
      "divider": "#e8e8e8",
      "accessible-cyan-text": "#0080a8",
      "link-blue": "#1264a3",
      "mention-highlight": "#fff3c4",
      "code-background": "#f4f4f4",
      "reaction-pill-bg": "#f0f0f0",
      "reaction-pill-active": "#e0eefa"
    },
    "semantic": {
      "success": "#2eb67d",
      "warning": "#ecb22e",
      "danger": "#e01e5a",
      "info": "#36c5f0"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Marketing Hero",
        "fontKey": "body",
        "size": "56px",
        "weight": 800,
        "lineHeight": "1.05",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "Marketing Sub",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.4",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "Page Heading",
        "fontKey": "body",
        "size": "28px",
        "weight": 900,
        "lineHeight": "1.2",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "22px",
        "weight": 700,
        "lineHeight": "1.3",
        "letterSpacing": "0"
      },
      {
        "role": "Channel Name",
        "fontKey": "body",
        "size": "15px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Message Body",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.46",
        "letterSpacing": "0"
      },
      {
        "role": "Username",
        "fontKey": "body",
        "size": "15px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Timestamp",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Sidebar Channel",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Sidebar Section",
        "fontKey": "body",
        "size": "15px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Code Inline",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Code Block",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Caption / Meta",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.38",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 4,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "12px",
    "lg": "20px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
