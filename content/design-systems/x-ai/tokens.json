{
  "version": 1,
  "meta": {
    "id": "x-ai",
    "title": "xAI",
    "category": "AI & LLM",
    "summary": "Elon Musk's AI lab. Stark monochrome, futuristic minimalism.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#ffffff",
    "slate": "#666666",
    "signal": "#3b82f6",
    "bone": "#1f2228",
    "border": "#e5e5e5",
    "surface": "#1f2228",
    "extended": {},
    "semantic": {
      "info": "#1f2228"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "mono",
        "size": "320px",
        "weight": 300,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "30px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "1.4px"
      },
      {
        "role": "Label / Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Small / Meta",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "24px",
      "s-4": "48px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "0px",
    "md": "24px",
    "lg": "48px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus (Accessibility)",
      "treatment": "ring with rgb(59,130,246)/0.5"
    }
  ],
  "components": {
    "buttonRadius": "24px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "24px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
