{
  "version": 1,
  "meta": {
    "id": "minimax",
    "title": "MiniMax",
    "category": "AI & LLM",
    "summary": "AI model provider. Bold dark interface with neon accents.",
    "surface": "web"
  },
  "colors": {
    "paper": "#bfdbfe",
    "ink": "#222222",
    "slate": "#45515e",
    "signal": "#ea5ec1",
    "bone": "#f2f3f5",
    "border": "#f2f3f5",
    "surface": "#ad1b89",
    "extended": {
      "brand-blue": "#1456f0",
      "sky-blue": "#3daeff",
      "primary-light": "#60a5fa",
      "primary-500": "#3b82f6",
      "primary-600": "#2563eb",
      "primary-700": "#1d4ed8",
      "brand-deep": "#17437d",
      "dark": "#18181b",
      "charcoal": "#181e25",
      "mid-gray": "#5f5f63",
      "light-gray": "#848484",
      "pure-white": "#ffffff",
      "border-gray": "#e5e7eb",
      "success-background": "#e8ffea"
    },
    "semantic": {
      "success": "#e8ffea",
      "info": "#1456f0"
    }
  },
  "typography": {
    "fontDisplay": "Outfit",
    "fontBody": "Outfit",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "80px",
        "weight": 500,
        "lineHeight": "1.10",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "31px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading Alt",
        "fontKey": "ui",
        "size": "32px",
        "weight": 600,
        "lineHeight": "0.88",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "display",
        "size": "28px",
        "weight": 500,
        "lineHeight": "1.71",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Label",
        "fontKey": "body",
        "size": "18px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "20px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Bold",
        "fontKey": "ui",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav/Link",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button Small",
        "fontKey": "ui",
        "size": "13px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.70",
        "letterSpacing": "0"
      },
      {
        "role": "Small Label",
        "fontKey": "ui",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Micro",
        "fontKey": "display",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "6px",
      "s-5": "8px",
      "s-6": "10px",
      "s-7": "11px",
      "s-8": "14px",
      "s-9": "16px",
      "s-10": "24px",
      "s-11": "32px",
      "s-12": "40px",
      "s-13": "50px",
      "s-14": "64px",
      "s-15": "80px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "11px",
    "lg": "16px",
    "full": "30px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "11px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "11px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
