{
  "version": 1,
  "meta": {
    "id": "framer",
    "title": "Framer",
    "category": "Design & Creative",
    "summary": "Website builder. Bold black and blue, motion-first, design-forward.",
    "surface": "web"
  },
  "colors": {
    "paper": "#000000",
    "ink": "#ffffff",
    "slate": "#a6a6a6",
    "signal": "#ffffff",
    "bone": "#090909",
    "border": "#0099ff",
    "surface": "#ffffff",
    "extended": {
      "default-link-blue": "#0000ee"
    },
    "semantic": {
      "info": "#0099ff"
    }
  },
  "typography": {
    "fontDisplay": "GT Walsheim Framer Medium",
    "fontBody": "GT Walsheim Framer Medium",
    "fontMono": "Azeret Mono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "110px",
        "weight": 500,
        "lineHeight": "0.85",
        "letterSpacing": "-5.5px"
      },
      {
        "role": "Section Display",
        "fontKey": "body",
        "size": "85px",
        "weight": 500,
        "lineHeight": "0.95",
        "letterSpacing": "-4.25px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "62px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "-3.1px"
      },
      {
        "role": "Feature Heading",
        "fontKey": "body",
        "size": "32px",
        "weight": 500,
        "lineHeight": "1.13",
        "letterSpacing": "-1px"
      },
      {
        "role": "Accent Display",
        "fontKey": "ui",
        "size": "61.5px",
        "weight": 100,
        "lineHeight": "1.00",
        "letterSpacing": "-3.1px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.01px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "22px",
        "weight": 700,
        "lineHeight": "1.20",
        "letterSpacing": "-0.8px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "-0.8px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.01px"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.01px"
      },
      {
        "role": "Nav/UI",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.15px"
      },
      {
        "role": "Body Readable",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Label",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Small Caption",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Code",
        "fontKey": "mono",
        "size": "10.4px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Badge",
        "fontKey": "body",
        "size": "9px",
        "weight": 600,
        "lineHeight": "1.11",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Uppercase",
        "fontKey": "body",
        "size": "7px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0.21px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "5px",
    "md": "10px",
    "lg": "80px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
