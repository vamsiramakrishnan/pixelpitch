{
  "version": 1,
  "meta": {
    "id": "atlassian",
    "title": "Atlassian",
    "category": "Productivity & SaaS",
    "summary": "Enterprise collaboration suite. Blue-driven hierarchy, dense information UI, board-and-backlog patterns.",
    "surface": "web"
  },
  "colors": {
    "paper": "#deebff",
    "ink": "#0052cc",
    "slate": "#7a869a",
    "signal": "#6554c0",
    "bone": "#ffffff",
    "border": "#ebecf0",
    "surface": "#ffffff",
    "extended": {
      "blue-400": "#0065ff",
      "blue-600": "#0747a6",
      "blue-700": "#003884",
      "blue-75": "#b3d4ff",
      "blue-50": "#e6effc",
      "green-500": "#00875a",
      "green-400": "#36b37e",
      "green-100": "#e3fcef",
      "red-500": "#ff5630",
      "red-400": "#ff7452",
      "red-100": "#ffebe6",
      "yellow-500": "#ffab00",
      "yellow-400": "#ffc400",
      "yellow-100": "#fff0b3",
      "teal-500": "#00b8d9",
      "teal-100": "#e6fcff",
      "purple-100": "#eae6ff",
      "n10": "#fafbfc",
      "n20": "#f4f5f7",
      "n40": "#dfe1e6",
      "n50": "#c1c7d0",
      "n60": "#b3bac5",
      "n80": "#6f7786",
      "n200": "#6b778c",
      "n300": "#5e6c84",
      "n500": "#42526e",
      "n700": "#253858",
      "n800": "#172b4d"
    },
    "semantic": {
      "success": "#00875a",
      "warning": "#ffab00",
      "danger": "#ff5630",
      "info": "#deebff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "\"SFMono-Medium\", \"SF Mono\", \"Segoe UI Mono\", \"Roboto Mono\", \"Ubuntu Mono\", Menlo, Consolas, Courier, monospace",
    "ramp": [
      {
        "role": "Marketing Display",
        "fontKey": "display",
        "size": "48px",
        "weight": 700,
        "lineHeight": "1.08",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Marketing Heading",
        "fontKey": "display",
        "size": "36px",
        "weight": 700,
        "lineHeight": "1.14",
        "letterSpacing": "-0.3px"
      },
      {
        "role": "Page Title (H700)",
        "fontKey": "body",
        "size": "29px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "Section Title (H600)",
        "fontKey": "body",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.17",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "Subsection (H500)",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "-0.008em"
      },
      {
        "role": "Card Title (H400)",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "-0.006em"
      },
      {
        "role": "Label (H300)",
        "fontKey": "body",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.14",
        "letterSpacing": "0"
      },
      {
        "role": "Overline (H200)",
        "fontKey": "body",
        "size": "12px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Subtitle (H100)",
        "fontKey": "body",
        "size": "11px",
        "weight": 700,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      },
      {
        "role": "Code Block",
        "fontKey": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Code Inline",
        "fontKey": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "4px",
      "s-3": "8px",
      "s-4": "12px",
      "s-5": "16px",
      "s-6": "20px",
      "s-7": "24px",
      "s-8": "32px",
      "s-9": "40px",
      "s-10": "48px",
      "s-11": "64px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "4px",
    "lg": "20px",
    "full": "16px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "3px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "4px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
