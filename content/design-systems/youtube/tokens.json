{
  "version": 1,
  "meta": {
    "id": "youtube",
    "title": "YouTube",
    "category": "Media & Consumer",
    "summary": "Video platform. Red play button, content-grid layout, thumbnail-driven discovery.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#0f0f0f",
    "slate": "#606060",
    "signal": "#ff0000",
    "bone": "#f2f2f2",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "dark-red": "#cc0000",
      "elevated-white": "#f9f9f9",
      "tertiary-text": "#909090",
      "link-blue": "#065fd4",
      "active-blue": "#3ea6ff",
      "like-green": "#1b7e1b",
      "chip-border": "#d9d9d9",
      "player-background": "#000000"
    },
    "semantic": {
      "success": "#1b7e1b",
      "danger": "#ff0000",
      "info": "#065fd4"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Page Heading",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Section Title",
        "fontKey": "body",
        "size": "18px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Video Title (List)",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.375",
        "letterSpacing": "0"
      },
      {
        "role": "Video Title (Watch)",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Channel Name",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Metadata",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Button Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Chip Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.29",
        "letterSpacing": "0"
      },
      {
        "role": "Comment Author",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.23",
        "letterSpacing": "0"
      },
      {
        "role": "Comment Body",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Timestamp",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Badge / Duration",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "10px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0.2px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "40px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Base (0)",
      "treatment": "No shadow"
    },
    {
      "level": 1,
      "name": "Surface (1)",
      "treatment": "rgba(0,0,0,0.1) 0 1px 2px"
    },
    {
      "level": 2,
      "name": "Elevated (2)",
      "treatment": "rgba(0,0,0,0.16) 0 2px 8px"
    },
    {
      "level": 3,
      "name": "Dialog (3)",
      "treatment": "rgba(0,0,0,0.24) 0 8px 24px"
    },
    {
      "level": 4,
      "name": "Player Controls",
      "treatment": "Gradient scrim rgba(0,0,0,0) → rgba(0,0,0,0.7)"
    },
    {
      "level": 5,
      "name": "Duration Badge",
      "treatment": "Solid rgba(0,0,0,0.6) fill"
    }
  ],
  "components": {
    "buttonRadius": "40px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
