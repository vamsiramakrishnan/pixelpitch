{
  "version": 1,
  "meta": {
    "id": "opencode-ai",
    "title": "OpenCode",
    "category": "AI & LLM",
    "summary": "AI coding platform. Developer-centric dark theme.",
    "surface": "web"
  },
  "colors": {
    "paper": "#201d1d",
    "ink": "#fdfcfc",
    "slate": "#9a9898",
    "signal": "#007aff",
    "bone": "#201d1d",
    "border": "#646262",
    "surface": "#fdfcfc",
    "extended": {
      "dark-surface": "#302c2c",
      "light-surface": "#f1eeee",
      "accent-blue-hover": "#0056b3",
      "accent-blue-active": "#004085",
      "danger-red": "#ff3b30",
      "danger-hover": "#d70015",
      "danger-active": "#a50011",
      "success-green": "#30d158",
      "warning-orange": "#ff9f0a",
      "warning-hover": "#cc7f08",
      "warning-active": "#995f06",
      "text-muted": "#6e6e73",
      "text-secondary": "#424245"
    },
    "semantic": {
      "success": "#30d158",
      "warning": "#ff9f0a",
      "danger": "#ff3b30",
      "info": "#007aff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Heading 1",
        "fontKey": "display",
        "size": "38px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 2",
        "fontKey": "display",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Tight",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "2.00",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "8px",
    "lg": "96px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
