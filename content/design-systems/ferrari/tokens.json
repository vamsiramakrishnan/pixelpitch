{
  "version": 1,
  "meta": {
    "id": "ferrari",
    "title": "Ferrari",
    "category": "Automotive",
    "summary": "Luxury automotive. Chiaroscuro editorial, Ferrari Red accents, cinematic black.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#181818",
    "slate": "#666666",
    "signal": "#da291c",
    "bone": "#d2d2d2",
    "border": "#d2d2d2",
    "surface": "#ffffff",
    "extended": {
      "dark-red": "#b01e0a",
      "deep-red": "#9d2211",
      "racing-yellow": "#fff200",
      "modena-yellow": "#f6e500",
      "absolute-black": "#000000",
      "dark-surface": "#303030",
      "mid-gray": "#8f8f8f",
      "silver-gray": "#969696",
      "warning-red": "#f13a2c",
      "success-green": "#03904a",
      "info-blue": "#4c98b9",
      "link-hover-blue": "#3860be"
    },
    "semantic": {
      "success": "#03904a",
      "warning": "#f13a2c",
      "danger": "#da291c",
      "info": "#4c98b9"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Section Title",
        "fontKey": "display",
        "size": "26px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Card Heading",
        "fontKey": "display",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Subheading",
        "fontKey": "display",
        "size": "18px",
        "weight": 700,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "UI Heading",
        "fontKey": "display",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.40",
        "letterSpacing": "0.08px"
      },
      {
        "role": "Body Bold",
        "fontKey": "body",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Button Label",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "1.28px"
      },
      {
        "role": "Small Button",
        "fontKey": "ui",
        "size": "14.4px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Link",
        "fontKey": "ui",
        "size": "13px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "0.13px"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.195px"
      },
      {
        "role": "Micro Button",
        "fontKey": "ui",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0.96px"
      },
      {
        "role": "Label Upper",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.27",
        "letterSpacing": "1px"
      },
      {
        "role": "Micro Label",
        "fontKey": "ui",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.27",
        "letterSpacing": "1px"
      },
      {
        "role": "Cookie Text",
        "fontKey": "body",
        "size": "45px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.195px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "5px",
    "md": "8px",
    "lg": "80px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
