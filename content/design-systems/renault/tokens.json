{
  "version": 1,
  "meta": {
    "id": "renault",
    "title": "Renault",
    "category": "Automotive",
    "summary": "French automotive. Vibrant aurora gradients, NouvelR typography, bold energy.",
    "surface": "web"
  },
  "colors": {
    "paper": "#efdf00",
    "ink": "#efdf00",
    "slate": "#666666",
    "signal": "#1883fd",
    "bone": "#777774",
    "border": "#777774",
    "surface": "#f2f2f2",
    "extended": {
      "absolute-black": "#000000",
      "pure-white": "#ffffff",
      "soft-yellow": "#f8eb4c",
      "charcoal": "#222222",
      "border-gray": "#d1d1d1",
      "success-green": "#8dc572",
      "error-rose": "#be6464",
      "warning-amber": "#f0ad4e",
      "info-blue": "#337ab7"
    },
    "semantic": {
      "success": "#8dc572",
      "warning": "#be6464",
      "danger": "#be6464",
      "info": "#337ab7"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Hero Title",
        "fontKey": "display",
        "size": "56px",
        "weight": 700,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "40px",
        "weight": 700,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "Card Heading",
        "fontKey": "display",
        "size": "32px",
        "weight": 700,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "Subheading",
        "fontKey": "display",
        "size": "24px",
        "weight": 700,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "Module Title",
        "fontKey": "display",
        "size": "21.92px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Content Title",
        "fontKey": "display",
        "size": "20px",
        "weight": 700,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "UI Heading",
        "fontKey": "display",
        "size": "19.2px",
        "weight": 600,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Emphasis",
        "fontKey": "body",
        "size": "18px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Body Heading",
        "fontKey": "display",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body Text",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body Bold",
        "fontKey": "body",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.57",
        "letterSpacing": "0"
      },
      {
        "role": "Button Label",
        "fontKey": "ui",
        "size": "14.4px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0.144px"
      },
      {
        "role": "Nav Link",
        "fontKey": "ui",
        "size": "13px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "12.8px",
        "weight": 400,
        "lineHeight": "1.10",
        "letterSpacing": "0"
      },
      {
        "role": "Small Label",
        "fontKey": "ui",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Text",
        "fontKey": "body",
        "size": "10px",
        "weight": 700,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Caption",
        "fontKey": "ui",
        "size": "8.5px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
