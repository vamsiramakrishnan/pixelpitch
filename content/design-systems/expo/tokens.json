{
  "version": 1,
  "meta": {
    "id": "expo",
    "title": "Expo",
    "category": "Developer Tools",
    "summary": "React Native platform. Dark theme, tight letter-spacing, code-centric.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f0f0f3",
    "ink": "#1c2024",
    "slate": "#60646c",
    "signal": "#47c2ff",
    "bone": "#333333",
    "border": "#7e8288",
    "surface": "#ffffff",
    "extended": {
      "expo-black": "#000000",
      "link-cobalt": "#0d74ce",
      "legal-blue": "#476cff",
      "preview-purple": "#8145b5",
      "widget-dark": "#1a1a1a",
      "banner-dark": "#171717",
      "mid-slate": "#555860",
      "silver": "#6a6e74",
      "pewter": "#999999",
      "light-silver": "#cccccc",
      "warning-amber": "#ab6400",
      "destructive-rose": "#eb8e90",
      "border-lavender": "#e0e1e6",
      "input-border": "#d9d9e0",
      "dark-focus-ring": "#2547d0"
    },
    "semantic": {
      "warning": "#ab6400",
      "danger": "#eb8e90",
      "info": "#1c2024"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "JetBrains Mono",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "64px",
        "weight": 700,
        "lineHeight": "1.10",
        "letterSpacing": "-1.6px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "-2px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "-0.25px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Caption / Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Tag / Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Code Caption",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      }
    ],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "8px",
      "s-5": "12px",
      "s-6": "16px",
      "s-7": "24px",
      "s-8": "32px",
      "s-9": "40px",
      "s-10": "48px",
      "s-11": "64px",
      "s-12": "80px",
      "s-13": "96px",
      "s-14": "144px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "8px",
    "lg": "16px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "24px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
