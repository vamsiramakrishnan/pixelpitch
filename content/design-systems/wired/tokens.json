{
  "version": 1,
  "meta": {
    "id": "wired",
    "title": "WIRED",
    "category": "Media & Consumer",
    "summary": "Tech magazine. Paper-white broadsheet density, custom serif display, mono kickers, ink-blue links.",
    "surface": "web"
  },
  "colors": {
    "paper": "#057dbc",
    "ink": "#000000",
    "slate": "#666666",
    "signal": "#057dbc",
    "bone": "#e2e8f0",
    "border": "#000000",
    "surface": "#e2e8f0",
    "extended": {
      "page-ink": "#1a1a1a",
      "paper-white": "#ffffff",
      "caption-gray": "#757575",
      "disabled-gray": "#999999"
    },
    "semantic": {
      "danger": "#000000",
      "info": "#057dbc"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Headline (Hero)",
        "fontKey": "display",
        "size": "64px",
        "weight": 400,
        "lineHeight": "0.93",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Display Headline (Mobile / Mid)",
        "fontKey": "display",
        "size": "26px",
        "weight": 400,
        "lineHeight": "1.08",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "20px",
        "weight": 700,
        "lineHeight": "1.20",
        "letterSpacing": "-0.28px"
      },
      {
        "role": "Subheading",
        "fontKey": "body",
        "size": "17px",
        "weight": 700,
        "lineHeight": "1.29",
        "letterSpacing": "-0.144px"
      },
      {
        "role": "Article Deck (Serif)",
        "fontKey": "body",
        "size": "19px",
        "weight": 400,
        "lineHeight": "1.47",
        "letterSpacing": "0.108px"
      },
      {
        "role": "Article Body (Serif)",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.09px"
      },
      {
        "role": "UI Heading",
        "fontKey": "body",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Button Label",
        "fontKey": "body",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Link (Inline UI)",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.29",
        "letterSpacing": "0.4px"
      },
      {
        "role": "Eyebrow / Kicker",
        "fontKey": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.23",
        "letterSpacing": "0.92px"
      },
      {
        "role": "Eyebrow Bold",
        "fontKey": "mono",
        "size": "13px",
        "weight": 700,
        "lineHeight": "1.23",
        "letterSpacing": "0"
      },
      {
        "role": "Section Ribbon",
        "fontKey": "mono",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "1.2px"
      },
      {
        "role": "Photo Caption",
        "fontKey": "body",
        "size": "12.73px",
        "weight": 700,
        "lineHeight": "2.20",
        "letterSpacing": "0.108px"
      },
      {
        "role": "Timestamp / Meta",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "1.1px"
      },
      {
        "role": "Tertiary Footer Link",
        "fontKey": "body",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      },
      {
        "role": "Inter UI Heading",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.23",
        "letterSpacing": "0.108px"
      },
      {
        "role": "Inter UI Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "12px",
    "lg": "24px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "0",
      "treatment": "No shadow, no border"
    },
    {
      "level": 1,
      "name": "1",
      "treatment": "1px solid #e2e8f0 hairline <hr>"
    },
    {
      "level": 2,
      "name": "2",
      "treatment": "1px solid #000000 hairline rule"
    },
    {
      "level": 3,
      "name": "3",
      "treatment": "2px solid #000000 border"
    },
    {
      "level": 4,
      "name": "4",
      "treatment": "Black ribbon bar (#000000 fill)"
    },
    {
      "level": 5,
      "name": "5",
      "treatment": "Inverted footer block"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
