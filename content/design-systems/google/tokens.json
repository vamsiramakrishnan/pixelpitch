{
  "version": 1,
  "meta": {
    "id": "google",
    "title": "Google (Material You)",
    "category": "Media & Consumer",
    "summary": "Google's Material You design language. Dynamic color, rounded surfaces, adaptive UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#fef7ff",
    "ink": "#1c1b1f",
    "slate": "#49454f",
    "signal": "#ea4335",
    "bone": "#cac4d0",
    "border": "#79747e",
    "surface": "#d3e3fd",
    "extended": {
      "primary": "#1a73e8",
      "blue-light-dark-mode": "#5a95ff",
      "on-primary": "#ffffff",
      "on-primary-container": "#041e49",
      "secondary": "#34a853",
      "secondary-container": "#c4eed0",
      "on-secondary-container": "#0d3919",
      "tertiary-container": "#ffd2cc",
      "on-tertiary-container": "#5c1008",
      "surface-dim": "#ded8e0",
      "surface-container-low": "#f8f1fa",
      "surface-container": "#f2ecf4",
      "surface-container-high": "#ece6ee",
      "surface-container-highest": "#e6e0e9",
      "inverse-surface": "#313033",
      "inverse-on-surface": "#f4eff4",
      "error": "#b3261e",
      "error-container": "#f9dedc",
      "on-error-container": "#410e0b",
      "google-yellow": "#fbbc04"
    },
    "semantic": {
      "warning": "#fbbc04",
      "danger": "#b3261e",
      "info": "#5a95ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Large",
        "fontKey": "ui",
        "size": "57px",
        "weight": 400,
        "lineHeight": "64",
        "letterSpacing": "-0.25px"
      },
      {
        "role": "Display Medium",
        "fontKey": "ui",
        "size": "45px",
        "weight": 400,
        "lineHeight": "52",
        "letterSpacing": "0px"
      },
      {
        "role": "Display Small",
        "fontKey": "ui",
        "size": "36px",
        "weight": 400,
        "lineHeight": "44",
        "letterSpacing": "0px"
      },
      {
        "role": "Headline Large",
        "fontKey": "ui",
        "size": "32px",
        "weight": 400,
        "lineHeight": "40",
        "letterSpacing": "0px"
      },
      {
        "role": "Headline Medium",
        "fontKey": "ui",
        "size": "28px",
        "weight": 400,
        "lineHeight": "36",
        "letterSpacing": "0px"
      },
      {
        "role": "Headline Small",
        "fontKey": "ui",
        "size": "24px",
        "weight": 400,
        "lineHeight": "32",
        "letterSpacing": "0px"
      },
      {
        "role": "Title Large",
        "fontKey": "body",
        "size": "22px",
        "weight": 400,
        "lineHeight": "28",
        "letterSpacing": "0px"
      },
      {
        "role": "Title Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "24",
        "letterSpacing": "0.15px"
      },
      {
        "role": "Title Small",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "20",
        "letterSpacing": "0.1px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "24",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "20",
        "letterSpacing": "0.25px"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "16",
        "letterSpacing": "0.4px"
      },
      {
        "role": "Label Large",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "20",
        "letterSpacing": "0.1px"
      },
      {
        "role": "Label Medium",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "16",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Label Small",
        "fontKey": "body",
        "size": "11px",
        "weight": 500,
        "lineHeight": "16",
        "letterSpacing": "0.5px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "24px",
    "lg": "12px",
    "full": "1200px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "40px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "1px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
