{
  "version": 1,
  "meta": {
    "id": "nike",
    "title": "Nike",
    "category": "E-Commerce & Retail",
    "summary": "Athletic retail. Monochrome UI, massive uppercase type, full-bleed photography.",
    "surface": "web"
  },
  "colors": {
    "paper": "#111111",
    "ink": "#111111",
    "slate": "#707072",
    "signal": "#ff5000",
    "bone": "#ffffff",
    "border": "#cacacb",
    "surface": "#ffffff",
    "extended": {
      "snow": "#fafafa",
      "light-gray": "#f5f5f5",
      "hover-gray": "#e5e5e5",
      "dark-surface": "#28282a",
      "deep-charcoal": "#1f1f21",
      "dark-hover": "#39393b",
      "disabled-text": "#9e9ea0",
      "disabled-inverse": "#4b4b4d",
      "nike-red": "#d30005",
      "bright-red": "#ee0005",
      "nike-orange-badge": "#d33918",
      "success-green": "#007d48",
      "success-inverse": "#1eaa52",
      "link-blue": "#1151ff",
      "info-inverse": "#1190ff",
      "warning-yellow": "#fedf35"
    },
    "semantic": {
      "success": "#007d48",
      "warning": "#fedf35",
      "danger": "#d30005",
      "info": "#1151ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display",
        "fontKey": "display",
        "size": "96px",
        "weight": 500,
        "lineHeight": "0.90",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 1",
        "fontKey": "display",
        "size": "32px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 2",
        "fontKey": "display",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 3",
        "fontKey": "display",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.75",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.75",
        "letterSpacing": "0"
      },
      {
        "role": "Link",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.75",
        "letterSpacing": "0"
      },
      {
        "role": "Link Small",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.86",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button Small",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Tiny",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 4,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "1440px",
    "lg": "80px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "No shadow, no border"
    },
    {
      "level": 1,
      "name": "Divider",
      "treatment": "0px -1px 0px 0px #E5E5E5 inset"
    },
    {
      "level": 2,
      "name": "Focus",
      "treatment": "0 0 0 2px rgba(39, 93, 197, 1)"
    },
    {
      "level": 3,
      "name": "Overlay",
      "treatment": "Dark scrim over photography"
    }
  ],
  "components": {
    "buttonRadius": "1440px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
