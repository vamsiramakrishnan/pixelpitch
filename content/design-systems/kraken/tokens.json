{
  "version": 1,
  "meta": {
    "id": "kraken",
    "title": "Kraken",
    "category": "Fintech & Crypto",
    "summary": "Crypto trading. Purple-accented dark UI, data-dense dashboards.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#101114",
    "slate": "#9497a9",
    "signal": "#7132f5",
    "bone": "#dedee5",
    "border": "#5741d8",
    "surface": "#ffffff",
    "extended": {
      "purple-deep": "#5b1ecf",
      "cool-gray": "#686b82",
      "green": "#149e61",
      "green-dark": "#026b3f"
    },
    "semantic": {
      "success": "#149e61",
      "info": "#9497a9"
    }
  },
  "typography": {
    "fontDisplay": "Kraken-Brand",
    "fontBody": "Kraken-Brand",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "48px",
        "weight": 700,
        "lineHeight": "1.17",
        "letterSpacing": "-1px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "36px",
        "weight": 700,
        "lineHeight": "1.22",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "28px",
        "weight": 700,
        "lineHeight": "1.29",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "22px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.38",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.38",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.38",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "7px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "5px",
    "md": "10px",
    "lg": "20px",
    "full": "9px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
