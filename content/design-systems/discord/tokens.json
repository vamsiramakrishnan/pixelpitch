{
  "version": 1,
  "meta": {
    "id": "discord",
    "title": "Discord",
    "category": "Productivity & SaaS",
    "summary": "Voice / chat platform. Deep blurple, dark-first surfaces, playful accent moments.",
    "surface": "web"
  },
  "colors": {
    "paper": "#5865f2",
    "ink": "#00a8fc",
    "slate": "#666666",
    "signal": "#7289da",
    "bone": "#3f4147",
    "border": "#3f4147",
    "surface": "#3f4147",
    "extended": {
      "blurple-hover": "#4752c4",
      "background-tertiary": "#1e1f22",
      "background-secondary": "#2b2d31",
      "background-primary": "#313338",
      "background-floating": "#111214",
      "light-bg-primary": "#ffffff",
      "light-bg-secondary": "#f2f3f5",
      "light-bg-tertiary": "#e3e5e8",
      "header-secondary": "#b5bac1",
      "text-normal": "#dbdee1",
      "text-muted": "#949ba4",
      "channels-default": "#80848e",
      "status-online": "#23a55a",
      "status-idle": "#f0b232",
      "status-dnd": "#f23f43",
      "status-streaming": "#593695"
    },
    "semantic": {
      "success": "#23a55a",
      "danger": "#f23f43",
      "info": "#00a8fc"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "ui",
        "size": "56px",
        "weight": 800,
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "Page Heading",
        "fontKey": "ui",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Channel Name",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Message Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.375",
        "letterSpacing": "0"
      },
      {
        "role": "Username",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Timestamp",
        "fontKey": "ui",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Sidebar Channel",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Server Name",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Caption / Meta",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.3",
        "letterSpacing": "0.02em"
      },
      {
        "role": "Code Block",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
