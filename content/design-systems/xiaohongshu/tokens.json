{
  "version": 1,
  "meta": {
    "id": "xiaohongshu",
    "title": "Xiaohongshu",
    "category": "Media & Consumer",
    "summary": "Lifestyle UGC social platform. Singular brand red, generous radius, content-first.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f5f5f5",
    "ink": "#133667",
    "slate": "#666666",
    "signal": "#ff2e4d",
    "bone": "#fafafa",
    "border": "#eaeaea",
    "surface": "#ffffff",
    "extended": {
      "star-yellow": "#fdbc5f",
      "success": "#02b940",
      "warning": "#ff7d03",
      "info": "#3d8af5",
      "surface": "#19191e",
      "canvas": "#0e0e11"
    },
    "semantic": {
      "success": "#02b940",
      "warning": "#ff7d03",
      "danger": "#133667",
      "info": "#fafafa"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": []
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
