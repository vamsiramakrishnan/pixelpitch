  "depth": [
    {
      "level": 0,
      "name": "Flat (0)",
      "treatment": "No shadow"
    },
    {
      "level": 1,
      "name": "Subtle (1)",
      "treatment": "0 4px 12px rgba(0,0,0,0.08)"
    },
    {
      "level": 2,
      "name": "Modal (2)",
      "treatment": "0 8px 32px rgba(0,0,0,0.12)"
    },
    {
      "level": 3,
      "name": "Dark mode",
      "treatment": "Drop shadows or replace with a 1px hairline (rgba(255,255,255,0.07))"
    }
  ],
  "components": {
    "buttonRadius": "240px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "240px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
