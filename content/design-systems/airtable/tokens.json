{
  "version": 1,
  "meta": {
    "id": "airtable",
    "title": "Airtable",
    "category": "Design & Creative",
    "summary": "Spreadsheet-database hybrid. Colorful, friendly, structured data aesthetic.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#181d26",
    "slate": "#333333",
    "signal": "#254fad",
    "bone": "#f8fafc",
    "border": "#e0e2e6",
    "surface": "#e0e2e6",
    "extended": {
      "airtable-blue": "#1b61c9",
      "success-green": "#006400"
    },
    "semantic": {
      "success": "#006400",
      "info": "#1b61c9"
    }
  },
  "typography": {
    "fontDisplay": "Haas Groot Disp",
    "fontBody": "Haas Groot Disp",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "0"
      },
      {
        "role": "Display Bold",
        "fontKey": "display",
        "size": "48px",
        "weight": 900,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0.12px"
      },
      {
        "role": "Feature",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0.1px"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.35",
        "letterSpacing": "0.18px"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "0.16px"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0.08px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0.28px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "12px",
    "md": "8px",
    "lg": "24px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
