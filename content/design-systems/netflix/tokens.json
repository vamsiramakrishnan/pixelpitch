{
  "version": 1,
  "meta": {
    "id": "netflix",
    "title": "Netflix",
    "category": "Media & Consumer",
    "summary": "The world's streaming platform. Cinematic dark UI, bold red accent, content-first design.",
    "surface": "web"
  },
  "colors": {
    "paper": "#141414",
    "ink": "#ffffff",
    "slate": "#b3b3b3",
    "signal": "#f40612",
    "bone": "#1c1c1c",
    "border": "#404040",
    "surface": "#181818",
    "extended": {
      "netflix-red": "#e50914",
      "netflix-red-dark": "#b1060f",
      "surface-warm": "#221f1f",
      "surface-elevated": "#2f2f2f",
      "surface-light": "#333333",
      "off-white": "#e5e5e5",
      "muted": "#808080",
      "charcoal": "#6d6d6d",
      "match-green": "#46d369",
      "maturity-gray": "#bcbcbc",
      "top-10-badge": "#b8192e",
      "warning-yellow": "#e6b616",
      "info-blue": "#0080ff"
    },
    "semantic": {
      "success": "#46d369",
      "warning": "#e6b616",
      "danger": "#e50914",
      "info": "#808080"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Hero Title",
        "fontKey": "display",
        "size": "64px",
        "weight": 700,
        "lineHeight": "1.1",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Section Header",
        "fontKey": "body",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.2",
        "letterSpacing": "0px"
      },
      {
        "role": "Card Title",
        "fontKey": "display",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.3",
        "letterSpacing": "0px"
      },
      {
        "role": "Body / Synopsis",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Metadata",
        "fontKey": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.4",
        "letterSpacing": "0px"
      },
      {
        "role": "Nav Link Active",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.0",
        "letterSpacing": "0px"
      },
      {
        "role": "Nav Link",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.0",
        "letterSpacing": "0px"
      },
      {
        "role": "Button Label",
        "fontKey": "ui",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.0",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Badge",
        "fontKey": "mono",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.0",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.3",
        "letterSpacing": "0.3px"
      }
    ]
  },
  "spacing": {
    "base": 4,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "56px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
