{
  "version": 1,
  "meta": {
    "id": "notion",
    "title": "Notion",
    "category": "Productivity & SaaS",
    "summary": "All-in-one workspace. Warm minimalism, serif headings, soft surfaces.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#0075de",
    "slate": "#615d59",
    "signal": "#0075de",
    "bone": "#ffffff",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "deep-navy": "#213183",
      "active-blue": "#005bab",
      "warm-white": "#f6f5f4",
      "warm-dark": "#31302e",
      "warm-gray-300": "#7b7670",
      "teal": "#2a9d99",
      "green": "#1aae39",
      "orange": "#dd5b00",
      "pink": "#ff64c8",
      "purple": "#391c57",
      "brown": "#523410",
      "link-light-blue": "#62aef0",
      "focus-blue": "#097fe8",
      "badge-blue-bg": "#f2f9ff"
    },
    "semantic": {
      "success": "#2a9d99",
      "warning": "#dd5b00",
      "info": "#ffffff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "64px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "-2.125px"
      },
      {
        "role": "Display Secondary",
        "fontKey": "body",
        "size": "54px",
        "weight": 700,
        "lineHeight": "1.04",
        "letterSpacing": "-1.875px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "-1.5px"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "body",
        "size": "40px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "26px",
        "weight": 700,
        "lineHeight": "1.23",
        "letterSpacing": "-0.625px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "22px",
        "weight": 700,
        "lineHeight": "1.27",
        "letterSpacing": "-0.25px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "-0.125px"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Semibold",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Bold",
        "fontKey": "body",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav / Button",
        "fontKey": "body",
        "size": "15px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Caption Light",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Badge",
        "fontKey": "body",
        "size": "12px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0.125px"
      },
      {
        "role": "Micro Label",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0.125px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "3px",
      "s-3": "4px",
      "s-4": "5px",
      "s-5": "6px",
      "s-6": "7px",
      "s-7": "8px",
      "s-8": "11px",
      "s-9": "12px",
      "s-10": "14px",
      "s-11": "16px",
      "s-12": "24px",
      "s-13": "32px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "5px",
    "md": "12px",
    "lg": "120px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus (Accessibility)",
      "treatment": "2px solid var(--focus-color) outline"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "16px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
