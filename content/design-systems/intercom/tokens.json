{
  "version": 1,
  "meta": {
    "id": "intercom",
    "title": "Intercom",
    "category": "Productivity & SaaS",
    "summary": "Customer messaging. Friendly blue palette, conversational UI patterns.",
    "surface": "web"
  },
  "colors": {
    "paper": "#111111",
    "ink": "#111111",
    "slate": "#7b7b78",
    "signal": "#ff5600",
    "bone": "#faf9f6",
    "border": "#dedbd6",
    "surface": "#faf9f6",
    "extended": {
      "pure-white": "#ffffff",
      "report-orange": "#fe4c02",
      "report-blue": "#65b5ff",
      "report-green": "#0bdf50",
      "report-red": "#c41c1c",
      "report-pink": "#ff2067",
      "report-lime": "#b3e01c",
      "green": "#00da00",
      "deep-blue": "#0007cb",
      "black-80": "#313130",
      "black-60": "#626260",
      "content-tertiary": "#9c9fa5",
      "warm-sand": "#d3cec6"
    },
    "semantic": {
      "success": "#0bdf50",
      "danger": "#c41c1c",
      "info": "#65b5ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "MediumLL",
    "fontMono": "SaansMono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "80px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-2.4px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "54px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.6px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.2px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.96px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.48px"
      },
      {
        "role": "Body Emphasis",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "0.95",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Nav / UI",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Light",
        "fontKey": "body",
        "size": "14px",
        "weight": 300,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button Bold",
        "fontKey": "body",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.20",
        "letterSpacing": "0.16px"
      },
      {
        "role": "Serif Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 300,
        "lineHeight": "1.40",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Mono Label",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0.6px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "16px",
    "md": "10px",
    "lg": "20px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
