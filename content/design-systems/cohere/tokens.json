{
  "version": 1,
  "meta": {
    "id": "cohere",
    "title": "Cohere",
    "category": "AI & LLM",
    "summary": "Enterprise AI platform. Vibrant gradients, data-rich dashboard aesthetic.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#212121",
    "slate": "#93939f",
    "signal": "#1863dc",
    "bone": "#ffffff",
    "border": "#9b60aa",
    "surface": "#ffffff",
    "extended": {
      "cohere-black": "#000000",
      "deep-dark": "#17171c",
      "ring-blue": "#4c6ee6",
      "snow": "#fafafa",
      "lightest-gray": "#f2f2f2",
      "border-cool": "#d9d9dd",
      "border-light": "#e5e7eb"
    },
    "semantic": {
      "info": "#17171c"
    }
  },
  "typography": {
    "fontDisplay": "CohereText",
    "fontBody": "CohereText",
    "fontMono": "CohereMono",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "display",
        "size": "72px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.44px"
      },
      {
        "role": "Display Secondary",
        "fontKey": "display",
        "size": "60px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.2px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-0.48px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-0.32px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button Medium",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.71",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Uppercase Label",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0.28px"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Code Micro",
        "fontKey": "mono",
        "size": "8px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0.16px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "6px",
      "s-3": "8px",
      "s-4": "10px",
      "s-5": "12px",
      "s-6": "16px",
      "s-7": "20px",
      "s-8": "22px",
      "s-9": "24px",
      "s-10": "28px",
      "s-11": "32px",
      "s-12": "36px",
      "s-13": "40px",
      "s-14": "56px",
      "s-15": "60px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "60px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "4px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
