{
  "version": 1,
  "meta": {
    "id": "openai",
    "title": "OpenAI",
    "category": "AI & LLM",
    "summary": "Calm, near-monochrome system anchored in deep teal-black with generous white space and editorial typography.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#0d0d0d",
    "slate": "#6e6e6e",
    "signal": "#10a37f",
    "bone": "#ffffff",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "soft-black": "#1a1a1a",
      "mist": "#fafafa",
      "pearl": "#f5f5f5",
      "cloud": "#ececec",
      "teal-deep": "#0a7a5e",
      "teal-soft": "#e8f5f0",
      "graphite": "#3c3c3c",
      "ash": "#777777",
      "stone": "#c4c4c4",
      "border-soft": "#ededed",
      "error": "#ef4146",
      "warning": "#f5a623",
      "info": "#2563eb"
    },
    "semantic": {
      "success": "#e8f5f0",
      "warning": "#f5a623",
      "danger": "#ef4146",
      "info": "#2563eb"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display",
        "fontKey": "body",
        "size": "56px",
        "weight": 400,
        "lineHeight": "1.08",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "H1",
        "fontKey": "body",
        "size": "40px",
        "weight": 600,
        "lineHeight": "1.15",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "H2",
        "fontKey": "body",
        "size": "28px",
        "weight": 600,
        "lineHeight": "1.2",
        "letterSpacing": "-0.005em"
      },
      {
        "role": "H3",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.3",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.6",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.65",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.4",
        "letterSpacing": "0.01em"
      },
      {
        "role": "Label",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.3",
        "letterSpacing": "0.04em"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "48px",
    "md": "64px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "64px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "64px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
