{
  "version": 1,
  "meta": {
    "id": "twitch",
    "title": "Twitch",
    "category": "Media & Consumer",
    "summary": "Live streaming platform. Electric purple, dark gaming UI, community-first design.",
    "surface": "web"
  },
  "colors": {
    "paper": "#0e0e10",
    "ink": "#dedee3",
    "slate": "#666666",
    "signal": "#e005b9",
    "bone": "#efeff1",
    "border": "#e5e5e5",
    "surface": "#1f1f23",
    "extended": {
      "twitch-purple": "#9146ff",
      "purple-hover": "#772ce8",
      "purple-dark": "#5c16c5",
      "background-alt": "#18181b",
      "background-float": "#26262c",
      "background-input": "#464649",
      "text-secondary": "#adadb8",
      "text-muted": "#53535f",
      "text-link": "#bf94ff",
      "live-red": "#eb0400",
      "success-green": "#00ad03",
      "warning-yellow": "#ffd000",
      "error-red": "#d0021b",
      "info-blue": "#1f69ff",
      "bits-blue": "#1db2ff",
      "sub-badge-gold": "#ffd700",
      "prediction-blue": "#1587e8",
      "prediction-pink": "#e81587"
    },
    "semantic": {
      "success": "#00ad03",
      "warning": "#ffd000",
      "danger": "#d0021b",
      "info": "#1f69ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Hero Display",
        "fontKey": "body",
        "size": "48px",
        "weight": 700,
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "Page Title",
        "fontKey": "body",
        "size": "32px",
        "weight": 700,
        "lineHeight": "1.2",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Stream Title",
        "fontKey": "body",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.3",
        "letterSpacing": "0"
      },
      {
        "role": "Channel Name",
        "fontKey": "body",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.4",
        "letterSpacing": "0"
      },
      {
        "role": "Chat Message",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.35",
        "letterSpacing": "0"
      },
      {
        "role": "Chat Username",
        "fontKey": "body",
        "size": "13px",
        "weight": 700,
        "lineHeight": "1.35",
        "letterSpacing": "0"
      },
      {
        "role": "Label / Button",
        "fontKey": "body",
        "size": "13px",
        "weight": 600,
        "lineHeight": "1.0",
        "letterSpacing": "0.02em"
      },
      {
        "role": "Caption / Meta",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.3",
        "letterSpacing": "0.01em"
      },
      {
        "role": "Badge Text",
        "fontKey": "body",
        "size": "10px",
        "weight": 700,
        "lineHeight": "1.0",
        "letterSpacing": "0.04em"
      },
      {
        "role": "Emote Alt",
        "fontKey": "body",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "8px",
    "lg": "16px",
    "full": "50px"
  },
  "depth": [
    {
      "level": 0,
      "name": "0 — Base",
      "treatment": "#0e0e10 flat"
    },
    {
      "level": 1,
      "name": "1 — Surface",
      "treatment": "#18181b flat"
    },
    {
      "level": 2,
      "name": "2 — Elevated",
      "treatment": "#1f1f23 flat"
    },
    {
      "level": 3,
      "name": "3 — Float",
      "treatment": "#26262c + rgba(0, 0, 0, 0.4) 0px 4px 8px"
    },
    {
      "level": 4,
      "name": "4 — Modal",
      "treatment": "#1f1f23 + rgba(0, 0, 0, 0.6) 0px 8px 24px"
    },
    {
      "level": 5,
      "name": "5 — Overlay",
      "treatment": "rgba(0, 0, 0, 0.5) scrim"
    },
    {
      "level": 6,
      "name": "6 — Notification",
      "treatment": "#9146ff glow + rgba(145, 70, 255, 0.3) 0px 0px 16px"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
