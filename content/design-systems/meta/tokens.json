{
  "version": 1,
  "meta": {
    "id": "meta",
    "title": "Meta (Store)",
    "category": "E-Commerce & Retail",
    "summary": "Tech retail store. Photography-first, binary light/dark surfaces, Meta Blue CTAs.",
    "surface": "web"
  },
  "colors": {
    "paper": "#0064e0",
    "ink": "#050505",
    "slate": "#5d6c7b",
    "signal": "#1877f2",
    "bone": "#ffffff",
    "border": "#ced0d4",
    "surface": "#ffffff",
    "extended": {
      "meta-blue-hover": "#0143b5",
      "meta-blue-pressed": "#004bb9",
      "meta-blue-light": "#47a5fa",
      "ray-ban-red": "#d6311f",
      "oculus-purple": "#a121ce",
      "work-purple": "#6441d2",
      "portal-blue": "#1b365d",
      "portal-hero-blue": "#c8e4e8",
      "portal-light-blue": "#add4e0",
      "soft-gray": "#f1f4f7",
      "warm-gray": "#f7f8fa",
      "web-wash": "#f0f2f5",
      "linen": "#f2f0e6",
      "baby-blue": "#e8f3ff",
      "near-black": "#1c1e21",
      "oculus-light": "#181a1b",
      "oculus-dark": "#000000",
      "dark-charcoal": "#1c2b33",
      "icon-secondary": "#465a69",
      "secondary-text": "#65676b",
      "section-header": "#4b4c4f",
      "button-text-gray": "#444950",
      "disabled-text": "#bcc0c4",
      "cta-disabled-text": "#8595a4",
      "divider-gray": "#dee3e9",
      "cta-gray-border": "#cbd2d9",
      "dark-gray-border": "#909396",
      "success-green": "#31a24c",
      "store-success": "#007d1e",
      "error-red": "#e41e3f",
      "store-error": "#c80a28",
      "warning-amber": "#f7b928",
      "cherry": "#f3425f",
      "grape": "#9360f7",
      "lime": "#45bd62",
      "seafoam": "#54c7ec",
      "teal": "#2abba7",
      "tomato": "#fb724b",
      "pink": "#ff66bf"
    },
    "semantic": {
      "success": "#31a24c",
      "warning": "#f7b928",
      "danger": "#e41e3f",
      "info": "#e8f3ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display 1",
        "fontKey": "display",
        "size": "64px",
        "weight": 500,
        "lineHeight": "1.16",
        "letterSpacing": "0"
      },
      {
        "role": "Display 2",
        "fontKey": "display",
        "size": "48px",
        "weight": 500,
        "lineHeight": "1.17",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 1",
        "fontKey": "display",
        "size": "36px",
        "weight": 500,
        "lineHeight": "1.28",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 2",
        "fontKey": "display",
        "size": "28px",
        "weight": 300,
        "lineHeight": "1.21",
        "letterSpacing": "0"
      },
      {
        "role": "Heading 3",
        "fontKey": "display",
        "size": "18px",
        "weight": 700,
        "lineHeight": "1.44",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.44",
        "letterSpacing": "0"
      },
      {
        "role": "Body Compact",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Caption Bold",
        "fontKey": "ui",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "-0.14px"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "-0.14px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "16px",
    "md": "8px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "No shadow, background differentiation only"
    },
    {
      "level": 1,
      "name": "Overlay",
      "treatment": "rgba(0,0,0,0.6) full-screen"
    },
    {
      "level": 2,
      "name": "Inset",
      "treatment": "rgba(255,255,255,0.5) inset"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "24px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
