    {
      "level": 0,
      "name": "0",
      "treatment": "No border, no shadow"
    },
    {
      "level": 1,
      "name": "1",
      "treatment": "rgba(0,0,0,0) 0px 0px 0px 0px inset (placeholder)"
    },
    {
      "level": 2,
      "name": "2",
      "treatment": "1px solid #ffffff or #313131 hairline"
    },
    {
      "level": 3,
      "name": "3",
      "treatment": "1px solid #3cffd0 hairline"
    },
    {
      "level": 4,
      "name": "4",
      "treatment": "1px solid #5200ff hairline"
    },
    {
      "level": 5,
      "name": "5",
      "treatment": "rgba(0, 0, 0, 0.33) 0px 0px 0px 1px"
    },
    {
      "level": 6,
      "name": "6",
      "treatment": "0px -1px 0px 0px inset (mint/black/white)"
    },
    {
      "level": 7,
      "name": "7",
      "treatment": "Saturated accent fill (#3cffd0, #5200ff, white, yellow, pink)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
