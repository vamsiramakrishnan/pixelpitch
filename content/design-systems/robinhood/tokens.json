{
  "version": 1,
  "meta": {
    "id": "robinhood",
    "title": "Robinhood",
    "category": "Fintech & Crypto",
    "summary": "Commission-free trading app. Green gains, minimalist finance, chart-forward UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#1e2124",
    "slate": "#666666",
    "signal": "#00bfa5",
    "bone": "#ffffff",
    "border": "#e8e8ea",
    "surface": "#ffffff",
    "extended": {
      "robinhood-green": "#00c805",
      "loss-red": "#ff5000",
      "neutral-gray": "#76767e",
      "brand-green-dark": "#00a033",
      "accessible-green-text": "#008b00",
      "brand-black": "#1c1e21",
      "surface-light-gray": "#f5f5f7",
      "surface-muted": "#f0f0f2",
      "text-secondary": "#6f7072",
      "disabled": "#c4c4c8"
    },
    "semantic": {
      "success": "#00c805",
      "danger": "#ff5000",
      "info": "#ff5000"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "SF Mono",
    "ramp": [
      {
        "role": "Portfolio Value",
        "fontKey": "body",
        "size": "40px",
        "weight": 500,
        "lineHeight": "1.10",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Stock Price",
        "fontKey": "body",
        "size": "32px",
        "weight": 500,
        "lineHeight": "1.15",
        "letterSpacing": "-0.3px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "-0.1px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "17px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "17px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Tab Label",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.4px"
      },
      {
        "role": "Gain/Loss %",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Ticker Symbol",
        "fontKey": "body",
        "size": "15px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.35",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Stat Label",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Stat Value",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "12px",
      "s-4": "16px",
      "s-5": "20px",
      "s-6": "24px",
      "s-7": "32px",
      "s-8": "40px",
      "s-9": "48px",
      "s-10": "64px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "full": "16px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
