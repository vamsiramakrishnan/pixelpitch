{
  "version": 1,
  "meta": {
    "id": "together-ai",
    "title": "Together AI",
    "category": "AI & LLM",
    "summary": "Open-source AI infrastructure. Technical, blueprint-style design.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#000000",
    "slate": "#666666",
    "signal": "#ef2cc1",
    "bone": "#bdbbff",
    "border": "#e5e5e5",
    "surface": "#010120",
    "extended": {
      "brand-orange": "#fc4c02"
    },
    "semantic": {
      "info": "#010120"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "64px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.92px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "-0.8px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "28px",
        "weight": 500,
        "lineHeight": "1.15",
        "letterSpacing": "-0.42px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "22px",
        "weight": 500,
        "lineHeight": "1.15",
        "letterSpacing": "-0.22px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.18px"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Mono Label",
        "fontKey": "mono",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.08px"
      },
      {
        "role": "Mono Small",
        "fontKey": "mono",
        "size": "11px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.08px"
      },
      {
        "role": "Mono Micro",
        "fontKey": "mono",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0.05px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "8px",
      "s-5": "10px",
      "s-6": "12px",
      "s-7": "16px",
      "s-8": "20px",
      "s-9": "24px",
      "s-10": "32px",
      "s-11": "44px",
      "s-12": "48px",
      "s-13": "80px",
      "s-14": "100px",
      "s-15": "120px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "120px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
