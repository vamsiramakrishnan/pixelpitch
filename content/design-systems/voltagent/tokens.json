{
  "version": 1,
  "meta": {
    "id": "voltagent",
    "title": "VoltAgent",
    "category": "AI & LLM",
    "summary": "AI agent framework. Void-black canvas, emerald accent, terminal-native.",
    "surface": "web"
  },
  "colors": {
    "paper": "#10b981",
    "ink": "#f2f2f2",
    "slate": "#b8b3b0",
    "signal": "#00d992",
    "bone": "#10b981",
    "border": "#00d992",
    "surface": "#101010",
    "extended": {
      "voltagent-mint": "#2fd6a1",
      "soft-purple": "#818cf8",
      "cobalt-primary": "#306cce",
      "deep-cobalt": "#2554a0",
      "ring-blue": "#3b82f6",
      "abyss-black": "#050507",
      "warm-charcoal-border": "#3d3a39",
      "pure-white": "#ffffff",
      "steel-slate": "#8b949e",
      "fog-gray": "#bdbdbd",
      "mist-gray": "#dcdcdc",
      "near-white": "#eeeeee",
      "success-emerald": "#008b00",
      "success-light": "#80d280",
      "warning-amber": "#ffba00",
      "warning-pale": "#ffdd80",
      "danger-coral": "#fb565b",
      "danger-rose": "#fd9c9f",
      "info-teal": "#4cb3d4",
      "dashed-border-slate": "#4f5d75"
    },
    "semantic": {
      "success": "#008b00",
      "warning": "#ffba00",
      "danger": "#fb565b",
      "info": "#4cb3d4"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "display",
        "size": "60px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.65px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "36px",
        "weight": 400,
        "lineHeight": "1.11",
        "letterSpacing": "-0.9px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "-0.6px"
      },
      {
        "role": "Sub-heading Light",
        "fontKey": "display",
        "size": "24px",
        "weight": 300,
        "lineHeight": "1.33",
        "letterSpacing": "-0.6px"
      },
      {
        "role": "Overline",
        "fontKey": "display",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 500,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Overline Small",
        "fontKey": "body",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.56",
        "letterSpacing": "0.45px"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Link",
        "fontKey": "body",
        "size": "14.45px",
        "weight": 500,
        "lineHeight": "1.65",
        "letterSpacing": "0"
      },
      {
        "role": "Caption / Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Tag / Overline Tiny",
        "fontKey": "display",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.43",
        "letterSpacing": "2.52px"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.23",
        "letterSpacing": "0"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Code Button",
        "fontKey": "mono",
        "size": "13px",
        "weight": 700,
        "lineHeight": "1.65",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "4px",
      "s-3": "5px",
      "s-4": "6px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "5px",
    "md": "8px",
    "lg": "96px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "6px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
