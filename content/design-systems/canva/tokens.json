{
  "version": 1,
  "meta": {
    "id": "canva",
    "title": "Canva",
    "category": "Design & Creative",
    "summary": "Visual creation platform. Vivid purple-blue gradient, generous spacing, friendly geometry.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#0e1318",
    "slate": "#666666",
    "signal": "#ff5757",
    "bone": "#f4f5f7",
    "border": "#e1e3e6",
    "surface": "#eef0fc",
    "extended": {
      "purple-to-blue-gradient": "#7d2ae8",
      "canva-cyan": "#00c4cc",
      "surface-inset": "#e8eaed",
      "ink-secondary": "#3c4043",
      "ink-muted": "#5f6368",
      "ink-faint": "#9aa0a6",
      "success": "#00b894",
      "warning": "#ffb020",
      "info": "#0d99ff",
      "coral": "#ff7059",
      "tangerine": "#ff9633",
      "mint": "#48c997",
      "sky": "#3ea6ff",
      "lavender": "#9b87f5",
      "border-strong": "#c7cdd3"
    },
    "semantic": {
      "success": "#00b894",
      "warning": "#ffb020",
      "info": "#0d99ff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Hero",
        "fontKey": "ui",
        "size": "64px",
        "weight": 800,
        "lineHeight": "1.05",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "H1",
        "fontKey": "ui",
        "size": "36px",
        "weight": 700,
        "lineHeight": "1.15",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "H2",
        "fontKey": "ui",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.2",
        "letterSpacing": "-0.005em"
      },
      {
        "role": "H3",
        "fontKey": "ui",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.3",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.4",
        "letterSpacing": "0.005em"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.2",
        "letterSpacing": "0"
      },
      {
        "role": "Tag",
        "fontKey": "ui",
        "size": "11px",
        "weight": 600,
        "lineHeight": "1.2",
        "letterSpacing": "0.04em"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "24px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
