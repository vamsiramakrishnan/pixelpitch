{
  "version": 1,
  "meta": {
    "id": "ollama",
    "title": "Ollama",
    "category": "AI & LLM",
    "summary": "Run LLMs locally. Terminal-first, monochrome simplicity.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#262626",
    "slate": "#737373",
    "signal": "#737373",
    "bone": "#fafafa",
    "border": "#e5e5e5",
    "surface": "#090909",
    "extended": {
      "pure-black": "#000000",
      "mid-gray": "#525252",
      "silver": "#777777",
      "button-text-dark": "#404040",
      "ring-blue": "#3b82f6",
      "border-light": "#d4d4d4"
    },
    "semantic": {
      "info": "#3b82f6"
    }
  },
  "typography": {
    "fontDisplay": "SF Pro Rounded",
    "fontBody": "SF Pro Rounded",
    "fontMono": "ui-monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "display",
        "size": "48px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "36px",
        "weight": 500,
        "lineHeight": "1.11",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "30px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "display",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "display",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.56",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Link",
        "fontKey": "display",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "display",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "display",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Code Caption",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.63",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "6px",
      "s-3": "8px",
      "s-4": "9px",
      "s-5": "10px",
      "s-6": "12px",
      "s-7": "14px",
      "s-8": "16px",
      "s-9": "20px",
      "s-10": "24px",
      "s-11": "32px",
      "s-12": "40px",
      "s-13": "48px",
      "s-14": "88px",
      "s-15": "112px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "12px",
    "lg": "88px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
