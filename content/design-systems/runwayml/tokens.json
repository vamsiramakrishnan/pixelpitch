{
  "version": 1,
  "meta": {
    "id": "runwayml",
    "title": "Runway",
    "category": "AI & LLM",
    "summary": "AI video generation. Cinematic dark UI, media-rich layout.",
    "surface": "web"
  },
  "colors": {
    "paper": "#000000",
    "ink": "#ffffff",
    "slate": "#767d88",
    "signal": "#828282",
    "bone": "#e9ecf2",
    "border": "#27272a",
    "surface": "#1a1a1a",
    "extended": {
      "deep-black": "#030303",
      "near-white": "#fefefe",
      "near-charcoal": "#3f3f3f",
      "mid-slate": "#7d848e",
      "muted-gray": "#a7a7a7",
      "cool-silver": "#c9ccd1",
      "light-silver": "#d0d4d4",
      "tailwind-gray": "#6b7280",
      "dark-link": "#0c0c0c",
      "footer-gray": "#999999"
    },
    "semantic": {
      "danger": "#030303",
      "info": "#e9ecf2"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.2px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.9px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Caption / Label",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0.35px"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Micro / Tag",
        "fontKey": "body",
        "size": "11px",
        "weight": 450,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "6px",
      "s-3": "8px",
      "s-4": "12px",
      "s-5": "16px",
      "s-6": "20px",
      "s-7": "24px",
      "s-8": "28px",
      "s-9": "32px",
      "s-10": "48px",
      "s-11": "64px",
      "s-12": "78px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "78px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
