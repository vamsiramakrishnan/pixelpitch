{
  "version": 1,
  "meta": {
    "id": "uber",
    "title": "Uber",
    "category": "Media & Consumer",
    "summary": "Mobility platform. Bold black and white, tight type, urban energy.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#4b4b4b",
    "slate": "#4b4b4b",
    "signal": "#000000",
    "bone": "#ffffff",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "hover-gray": "#e2e2e2",
      "hover-light": "#f3f3f3",
      "chip-gray": "#efefef",
      "muted-gray": "#777777",
      "default-link-blue": "#0000ee"
    },
    "semantic": {
      "info": "#0000ee"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "52px",
        "weight": 700,
        "lineHeight": "1.23",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 700,
        "lineHeight": "1.22",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "32px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Small Heading",
        "fontKey": "body",
        "size": "20px",
        "weight": 700,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Nav / UI Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.14",
        "letterSpacing": "0"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.67",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "6px",
      "s-3": "8px",
      "s-4": "10px",
      "s-5": "12px",
      "s-6": "14px",
      "s-7": "16px",
      "s-8": "18px",
      "s-9": "20px",
      "s-10": "24px",
      "s-11": "32px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "0px",
    "md": "12px",
    "lg": "96px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus Ring",
      "treatment": "rgb(255,255,255) 0px 0px 0px 2px inset"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
