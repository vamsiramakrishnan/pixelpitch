{
  "version": 1,
  "meta": {
    "id": "coinbase",
    "title": "Coinbase",
    "category": "Fintech & Crypto",
    "summary": "Crypto exchange. Clean blue identity, trust-focused, institutional feel.",
    "surface": "web"
  },
  "colors": {
    "paper": "#0a0b0d",
    "ink": "#0a0b0d",
    "slate": "#666666",
    "signal": "#0052ff",
    "bone": "#eef0f3",
    "border": "#0052ff",
    "surface": "#282b31",
    "extended": {
      "pure-white": "#ffffff",
      "hover-blue": "#578bfa",
      "link-blue": "#0667d0",
      "muted-blue": "#5b616e"
    },
    "semantic": {
      "info": "#0052ff"
    }
  },
  "typography": {
    "fontDisplay": "CoinbaseDisplay",
    "fontBody": "CoinbaseText",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "80px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Display Secondary",
        "fontKey": "display",
        "size": "64px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Display Third",
        "fontKey": "display",
        "size": "52px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "36px",
        "weight": 400,
        "lineHeight": "1.11",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "ui",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.13",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "ui",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Body Bold",
        "fontKey": "ui",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Semibold",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.56",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "ui",
        "size": "13px",
        "weight": 600,
        "lineHeight": "1.23",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "3px",
      "s-3": "4px",
      "s-4": "5px",
      "s-5": "6px",
      "s-6": "8px",
      "s-7": "10px",
      "s-8": "12px",
      "s-9": "15px",
      "s-10": "16px",
      "s-11": "20px",
      "s-12": "24px",
      "s-13": "25px",
      "s-14": "32px",
      "s-15": "48px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "12px",
    "lg": "24px",
    "full": "56px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
