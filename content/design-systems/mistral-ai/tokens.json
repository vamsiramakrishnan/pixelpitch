{
  "version": 1,
  "meta": {
    "id": "mistral-ai",
    "title": "Mistral AI",
    "category": "AI & LLM",
    "summary": "Open-weight LLM provider. French-engineered minimalism, purple-toned.",
    "surface": "web"
  },
  "colors": {
    "paper": "#fffaeb",
    "ink": "#111111",
    "slate": "#666666",
    "signal": "#ff8a00",
    "bone": "#fffaeb",
    "border": "#e5e5e5",
    "surface": "#fff0c2",
    "extended": {
      "mistral-orange": "#fa520f",
      "mistral-flame": "#fb6424",
      "block-orange": "#ff8105",
      "sunshine-700": "#ffa110",
      "sunshine-500": "#ffb83e",
      "sunshine-300": "#ffd06a",
      "block-gold": "#ffe295",
      "bright-yellow": "#ffd900",
      "pure-white": "#ffffff",
      "mistral-black": "#1f1f1f"
    },
    "semantic": {
      "warning": "#ff8a00",
      "danger": "#fa520f"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "body",
        "size": "82px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-2.05px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "56px",
        "weight": 400,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "0.95",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "30px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button Uppercase",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption / Link",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "4px",
      "s-3": "8px",
      "s-4": "10px",
      "s-5": "12px",
      "s-6": "16px",
      "s-7": "20px",
      "s-8": "24px",
      "s-9": "32px",
      "s-10": "40px",
      "s-11": "48px",
      "s-12": "64px",
      "s-13": "80px",
      "s-14": "98px",
      "s-15": "100px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "10px",
    "lg": "80px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
