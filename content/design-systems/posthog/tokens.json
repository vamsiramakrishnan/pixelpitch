{
  "version": 1,
  "meta": {
    "id": "posthog",
    "title": "PostHog",
    "category": "Backend & Data",
    "summary": "Product analytics. Playful hedgehog branding, developer-friendly dark UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#fdfdf8",
    "ink": "#4d4f46",
    "slate": "#65675e",
    "signal": "#f54e00",
    "bone": "#eeefe9",
    "border": "#b17816",
    "surface": "#eeefe9",
    "extended": {
      "deep-olive": "#23251d",
      "amber-gold": "#f7a501",
      "focus-blue": "#3b82f6",
      "light-sage": "#747670",
      "warm-tan": "#d4c9b8",
      "hover-white": "#f4f4f4",
      "sage-placeholder": "#9ea096",
      "sage-border": "#bfc1b7",
      "light-border": "#b6b7af",
      "dark-text": "#111827"
    },
    "semantic": {
      "success": "#23251d",
      "warning": "#f7a501",
      "danger": "#b17816",
      "info": "#3b82f6"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "ui",
        "size": "30px",
        "weight": 800,
        "lineHeight": "1.20",
        "letterSpacing": "-0.75px"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "36px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Feature Heading",
        "fontKey": "ui",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "0px"
      },
      {
        "role": "Card Heading",
        "fontKey": "ui",
        "size": "21.4px",
        "weight": 700,
        "lineHeight": "1.40",
        "letterSpacing": "-0.54px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "ui",
        "size": "20px",
        "weight": 700,
        "lineHeight": "1.40",
        "letterSpacing": "-0.5px"
      },
      {
        "role": "Sub-heading Uppercase",
        "fontKey": "ui",
        "size": "20px",
        "weight": 700,
        "lineHeight": "1.40",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Emphasis",
        "fontKey": "ui",
        "size": "19.3px",
        "weight": 600,
        "lineHeight": "1.56",
        "letterSpacing": "-0.48px"
      },
      {
        "role": "Label Uppercase",
        "fontKey": "ui",
        "size": "18px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Semi",
        "fontKey": "ui",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.56",
        "letterSpacing": "0px"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Medium",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Relaxed",
        "fontKey": "ui",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.71",
        "letterSpacing": "0px"
      },
      {
        "role": "Nav / UI",
        "fontKey": "ui",
        "size": "15px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0px"
      },
      {
        "role": "Small Label",
        "fontKey": "ui",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Micro",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0px"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.43",
        "letterSpacing": "0px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "1200px",
    "full": "9px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
