{
  "version": 1,
  "meta": {
    "id": "replicate",
    "title": "Replicate",
    "category": "AI & LLM",
    "summary": "Run ML models via API. Clean white canvas, code-forward.",
    "surface": "web"
  },
  "colors": {
    "paper": "#2b9a66",
    "ink": "#202020",
    "slate": "#646464",
    "signal": "#ea2804",
    "bone": "#f5f5f5",
    "border": "#202020",
    "surface": "#202020",
    "extended": {
      "secondary-red": "#dd4425",
      "github-dark": "#24292e",
      "pure-white": "#ffffff",
      "near-white": "#fcfcfc",
      "warm-gray": "#4e4e4e",
      "mid-silver": "#8d8d8d",
      "light-silver": "#bbbbbb",
      "pure-black": "#000000"
    },
    "semantic": {
      "success": "#2b9a66",
      "danger": "#ea2804",
      "info": "#24292e"
    }
  },
  "typography": {
    "fontDisplay": "rb-freigeist-neue",
    "fontBody": "rb-freigeist-neue",
    "fontMono": "jetbrains-mono",
    "ramp": [
      {
        "role": "Display Mega",
        "fontKey": "display",
        "size": "128px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Display / Hero",
        "fontKey": "display",
        "size": "72px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "-1.8px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "30px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading Sans",
        "fontKey": "body",
        "size": "38.4px",
        "weight": 400,
        "lineHeight": "0.83",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "display",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.56",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Button",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "-0.35px"
      },
      {
        "role": "Small / Tag",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "6px",
      "s-5": "8px",
      "s-6": "10px",
      "s-7": "12px",
      "s-8": "16px",
      "s-9": "24px",
      "s-10": "32px",
      "s-11": "48px",
      "s-12": "64px",
      "s-13": "96px",
      "s-14": "160px",
      "s-15": "192px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "10px",
    "lg": "192px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
