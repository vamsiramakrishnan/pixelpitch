{
  "version": 1,
  "meta": {
    "id": "spotify",
    "title": "Spotify",
    "category": "Media & Consumer",
    "summary": "Music streaming. Vibrant green on dark, bold type, album-art-driven.",
    "surface": "web"
  },
  "colors": {
    "paper": "#121212",
    "ink": "#ffffff",
    "slate": "#b3b3b3",
    "signal": "#1ed760",
    "bone": "#252525",
    "border": "#808080",
    "surface": "#181818",
    "extended": {
      "mid-dark": "#1f1f1f",
      "near-white": "#cbcbcb",
      "light": "#fdfdfd",
      "negative-red": "#f3727f",
      "warning-orange": "#ffa42b",
      "announcement-blue": "#539df5",
      "mid-card": "#272727",
      "light-border": "#7c7c7c",
      "light-surface": "#eeeeee",
      "spotify-green-border": "#1db954"
    },
    "semantic": {
      "success": "#1ed760",
      "warning": "#ffa42b",
      "danger": "#f3727f",
      "info": "#539df5"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Section Title",
        "fontKey": "ui",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Heading",
        "fontKey": "ui",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Body Bold",
        "fontKey": "ui",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Button Uppercase",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "1.4px"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.5",
        "letterSpacing": "0.14px"
      },
      {
        "role": "Nav Link Bold",
        "fontKey": "ui",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Link",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Caption Bold",
        "fontKey": "ui",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Small Bold",
        "fontKey": "ui",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Badge",
        "fontKey": "ui",
        "size": "10.5px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Micro",
        "fontKey": "ui",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "3px",
      "s-4": "4px",
      "s-5": "5px",
      "s-6": "6px",
      "s-7": "8px",
      "s-8": "10px",
      "s-9": "12px",
      "s-10": "14px",
      "s-11": "15px",
      "s-12": "16px",
      "s-13": "20px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "100px",
    "full": "500px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Inset (Border)",
      "treatment": "rgb(18,18,18) 0px 1px 0px, rgb(124,124,124) 0px 0px 0px 1px inset"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
