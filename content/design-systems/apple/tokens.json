{
  "version": 1,
  "meta": {
    "id": "apple",
    "title": "Apple",
    "category": "Media & Consumer",
    "summary": "Consumer electronics. Premium white space, SF Pro, cinematic imagery.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#1d1d1f",
    "slate": "#666666",
    "signal": "#0071e3",
    "bone": "#d2d2d7",
    "border": "#d2d2d7",
    "surface": "#272729",
    "extended": {
      "absolute-black": "#000000",
      "pale-apple-gray": "#f5f5f7",
      "body-link-blue": "#0066cc",
      "high-luminance-link-blue": "#2997ff",
      "graphite-surface-b": "#262629",
      "graphite-surface-c": "#28282b",
      "graphite-surface-d": "#2a2a2c",
      "secondary-neutral-gray": "#6e6e73",
      "mid-border-gray": "#86868b",
      "utility-dark-gray": "#424245"
    },
    "semantic": {
      "danger": "#2997ff",
      "info": "#0071e3"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Hero Display XL",
        "fontKey": "display",
        "size": "80px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "-1.2px"
      },
      {
        "role": "Hero Display L",
        "fontKey": "display",
        "size": "56px",
        "weight": 600,
        "lineHeight": "1.07",
        "letterSpacing": "-0.28px"
      },
      {
        "role": "Section Display",
        "fontKey": "display",
        "size": "48px",
        "weight": 500,
        "lineHeight": "1.08",
        "letterSpacing": "-0.144px"
      },
      {
        "role": "Product Heading",
        "fontKey": "display",
        "size": "40px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "0"
