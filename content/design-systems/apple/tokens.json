  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "20px",
    "lg": "18px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Accessibility",
      "treatment": "Blue focus signal (#0071e3)"
    }
  ],
  "components": {
    "buttonRadius": "20px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "20px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
