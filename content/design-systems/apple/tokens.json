      {
        "role": "Body Primary",
        "fontKey": "body",
        "size": "17px",
        "weight": 400,
        "lineHeight": "1.47",
        "letterSpacing": "-0.374px"
      },
      {
        "role": "Body Emphasis",
        "fontKey": "body",
        "size": "17px",
        "weight": 600,
        "lineHeight": "1.24",
        "letterSpacing": "-0.374px"
      },
      {
        "role": "Control Label",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.29",
        "letterSpacing": "-0.224px"
      },
      {
        "role": "Micro UI",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.12px"
      },
      {
        "role": "Legal/Meta",
        "fontKey": "mono",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.08px"
      }
