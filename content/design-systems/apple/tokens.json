        "letterSpacing": "0.196px"
      },
      {
        "role": "Utility Heading",
        "fontKey": "display",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.17",
        "letterSpacing": "0.216px"
      },
      {
        "role": "Link/Action Heading",
        "fontKey": "display",
        "size": "21px",
        "weight": 600,
        "lineHeight": "1.14",
        "letterSpacing": "0.231px"
      },
      {
        "role": "Subhead",
        "fontKey": "body",
        "size": "19px",
        "weight": 600,
        "lineHeight": "1.21",
        "letterSpacing": "0.228px"
