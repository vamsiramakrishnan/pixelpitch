{
  "version": 1,
  "meta": {
    "id": "duolingo",
    "title": "Duolingo",
    "category": "Productivity & SaaS",
    "summary": "Language-learning platform. Bright owl green, chunky shadows, gamified joy.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#3c3c3c",
    "slate": "#777777",
    "signal": "#58cc02",
    "bone": "#f7f7f7",
    "border": "#58cc02",
    "surface": "#ff4b4b",
    "extended": {
      "accessible-duo-green-text": "#008b00",
      "owl-green-deep": "#58a700",
      "owl-green-light": "#89e219",
      "owl-green-pale": "#dbf8c5",
      "streak-orange": "#ff9600",
      "streak-orange-deep": "#cc7a00",
      "gem-pink": "#ce82ff",
      "eel-blue": "#1cb0f6",
      "bee-yellow": "#ffc800",
      "swan": "#e5e5e5",
      "hare": "#afafaf"
    },
    "semantic": {
      "success": "#dbf8c5",
      "warning": "#ffc800",
      "danger": "#58cc02",
      "info": "#1cb0f6"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display",
        "fontKey": "body",
        "size": "56px",
        "weight": 800,
        "lineHeight": "1.05",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "H1",
        "fontKey": "body",
        "size": "32px",
        "weight": 800,
        "lineHeight": "1.15",
        "letterSpacing": "-0.005em"
      },
      {
        "role": "H2",
        "fontKey": "body",
        "size": "24px",
        "weight": 800,
        "lineHeight": "1.2",
        "letterSpacing": "0"
      },
      {
        "role": "H3",
        "fontKey": "body",
        "size": "18px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "17px",
        "weight": 500,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "13px",
        "weight": 600,
        "lineHeight": "1.4",
        "letterSpacing": "0.01em"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "16px",
        "weight": 800,
        "lineHeight": "1.2",
        "letterSpacing": "0.02em"
      },
      {
        "role": "Streak",
        "fontKey": "body",
        "size": "14px",
        "weight": 800,
        "lineHeight": "1.2",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
