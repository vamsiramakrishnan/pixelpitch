{
  "version": 1,
  "meta": {
    "id": "kami",
    "title": "kami (紙 / 纸)",
    "category": "Editorial & Print",
    "summary": "Editorial paper system: warm parchment canvas, ink-blue accent, serif-led hierarchy. Built for resumes, one-pagers, white papers, portfolios, slide decks — anything that should feel like high-quality print rather than UI. Multilingual by de",
    "surface": "web"
  },
  "colors": {
    "paper": "#f5f4ed",
    "ink": "#1b365d",
    "slate": "#30302e",
    "signal": "#1b365d",
    "bone": "#faf9f5",
    "border": "#e5e3d8",
