  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "3px",
      "s-3": "4px",
      "s-4": "8px",
      "s-5": "9px",
      "s-6": "10px",
      "s-7": "11px",
      "s-8": "12px",
      "s-9": "16px",
      "s-10": "18px",
      "s-11": "20px",
      "s-12": "24px",
      "s-13": "28px",
      "s-14": "32px",
      "s-15": "40px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "10px",
    "lg": "18px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus (Accessibility)",
      "treatment": "var(--tw-ring-offset-shadow) blue ring"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
