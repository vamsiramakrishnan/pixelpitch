{
  "version": 1,
  "meta": {
    "id": "elevenlabs",
    "title": "ElevenLabs",
    "category": "AI & LLM",
    "summary": "AI voice platform. Dark cinematic UI, audio-waveform aesthetics.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#000000",
    "slate": "#4e4e4e",
    "signal": "#4e4e4e",
    "bone": "#f5f5f5",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "warm-stone": "#f5f2ef",
      "warm-gray": "#777169",
      "near-white": "#f6f6f6",
      "grid-cyan": "#7fffff"
    },
    "semantic": {}
  },
  "typography": {
    "fontDisplay": "Waldenburg",
    "fontBody": "Waldenburg",
    "fontMono": "Geist Mono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "48px",
        "weight": 300,
        "lineHeight": "1.08",
        "letterSpacing": "-0.96px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "36px",
        "weight": 300,
        "lineHeight": "1.17",
        "letterSpacing": "0"
      },
      {
        "role": "Card Heading",
        "fontKey": "display",
        "size": "32px",
        "weight": 300,
        "lineHeight": "1.13",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.35",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.44",
        "letterSpacing": "0.18px"
      },
      {
        "role": "Body Standard",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.16px"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0.16px"
      },
      {
        "role": "Nav / UI",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0.15px"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.47",
        "letterSpacing": "0"
      },
      {
        "role": "Button Uppercase",
        "fontKey": "display",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.10",
        "letterSpacing": "0.7px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0.14px"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.38",
        "letterSpacing": "0"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.85",
        "letterSpacing": "0"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Tiny",
        "fontKey": "body",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      }
