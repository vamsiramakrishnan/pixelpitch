{
  "version": 1,
  "meta": {
    "id": "sentry",
    "title": "Sentry",
    "category": "Backend & Data",
    "summary": "Error monitoring. Dark dashboard, data-dense, pink-purple accent.",
    "surface": "web"
  },
  "colors": {
    "paper": "#1f1633",
    "ink": "#ffffff",
    "slate": "#e5e7eb",
    "signal": "#c2ef4e",
    "bone": "#362d59",
    "border": "#362d59",
    "surface": "#422082",
    "extended": {
      "darker-purple": "#150f23",
      "sentry-purple": "#6a5fc1",
      "muted-purple": "#79628c",
      "coral": "#ffb287",
      "pink": "#fa7faa",
      "code-yellow": "#dcdcaa",
      "input-border": "#cfcfdb"
    },
    "semantic": {
      "success": "#c2ef4e",
      "warning": "#dcdcaa"
    }
  },
  "typography": {
    "fontDisplay": "Dammit Sans",
    "fontBody": "Dammit Sans",
    "fontMono": "Monaco",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "88px",
        "weight": 700,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Display Secondary",
        "fontKey": "display",
        "size": "60px",
        "weight": 500,
        "lineHeight": "1.10",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "30px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "27px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Emphasis",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Label",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Uppercase Label",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Button Text",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.14",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Small Caption",
        "fontKey": "body",
        "size": "12px",
        "weight": 600,
        "lineHeight": "2.00",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Label",
        "fontKey": "body",
        "size": "10px",
        "weight": 600,
        "lineHeight": "1.80",
        "letterSpacing": "0.25px"
      },
      {
        "role": "Code",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px",
      "s-4": "5px",
      "s-5": "6px",
      "s-6": "8px",
      "s-7": "12px",
      "s-8": "16px",
      "s-9": "24px",
      "s-10": "32px",
      "s-11": "40px",
      "s-12": "44px",
      "s-13": "45px",
      "s-14": "47px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "640px",
    "md": "10px",
    "lg": "64px",
    "full": "18px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
