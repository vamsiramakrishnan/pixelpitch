{
  "version": 1,
  "meta": {
    "id": "supabase",
    "title": "Supabase",
    "category": "Backend & Data",
    "summary": "Open-source Firebase alternative. Dark emerald theme, code-first.",
    "surface": "web"
  },
  "colors": {
    "paper": "#171717",
    "ink": "#fafafa",
    "slate": "#898989",
    "signal": "#3ecf8e",
    "bone": "#efefef",
    "border": "#3ecf8e",
    "surface": "#2e2e2e",
    "extended": {
      "green-link": "#00c573",
      "near-black": "#0f0f0f",
      "dark-border": "#242424",
      "mid-border": "#363636",
      "border-light": "#393939",
      "charcoal": "#434343",
      "dark-gray": "#7f7f7f",
      "light-gray": "#b4b4b4"
    },
    "semantic": {
      "success": "#3ecf8e"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "Source Code Pro",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "72px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "-0.16px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.56",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Link",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.14",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Code Label",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "1.2px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "4px",
      "s-3": "6px",
      "s-4": "8px",
      "s-5": "12px",
      "s-6": "16px",
      "s-7": "20px",
      "s-8": "24px",
      "s-9": "32px",
      "s-10": "40px",
      "s-11": "48px",
      "s-12": "90px",
      "s-13": "96px",
      "s-14": "128px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "8px",
    "lg": "48px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
