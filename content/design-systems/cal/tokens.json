{
  "version": 1,
  "meta": {
    "id": "cal",
    "title": "Cal.com",
    "category": "Productivity & SaaS",
    "summary": "Open-source scheduling. Clean neutral UI, developer-oriented simplicity.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#0099ff",
    "slate": "#898989",
    "signal": "#0000ee",
    "bone": "#111111",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "charcoal": "#242424",
      "focus-ring": "#3b82f6",
      "pure-black": "#000000"
    },
    "semantic": {
      "info": "#0099ff"
    }
  },
  "typography": {
    "fontDisplay": "Cal Sans",
    "fontBody": "Inter",
    "fontMono": "Roboto Mono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "64px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "0px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "48px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "0px"
      },
      {
        "role": "Feature Heading",
        "fontKey": "display",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.30",
        "letterSpacing": "0px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Sub-heading Alt",
        "fontKey": "display",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Card Title",
        "fontKey": "display",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "0px"
      },
      {
        "role": "Caption Label",
        "fontKey": "display",
        "size": "12px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Light",
        "fontKey": "display",
        "size": "18px",
        "weight": 300,
        "lineHeight": "1.30",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Body Light Standard",
        "fontKey": "display",
        "size": "16px",
        "weight": 300,
        "lineHeight": "1.50",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Caption Light",
        "fontKey": "display",
        "size": "14px",
        "weight": 300,
        "lineHeight": "1.40",
        "letterSpacing": "-0.28px"
      },
      {
        "role": "UI Label",
        "fontKey": "body",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Caption Inter",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.14",
        "letterSpacing": "0px"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Matter",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.14",
        "letterSpacing": "0px"
      }
    ],
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "full": "9px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
