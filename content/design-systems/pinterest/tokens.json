{
  "version": 1,
  "meta": {
    "id": "pinterest",
    "title": "Pinterest",
    "category": "Media & Consumer",
    "summary": "Visual discovery. Red accent, masonry grid, image-first.",
    "surface": "web"
  },
  "colors": {
    "paper": "#0866ff",
    "ink": "#211922",
    "slate": "#62625b",
    "signal": "#e60023",
    "bone": "#e5e5e0",
    "border": "#91918c",
    "surface": "#ffffff",
    "extended": {
      "green-700": "#103c25",
      "green-700-hover": "#0b2819",
      "black": "#000000",
      "focus-blue": "#435ee5",
      "performance-purple": "#6845ab",
      "recommendation-purple": "#7e238b",
      "link-blue": "#2b48d4",
      "pressed-blue": "#617bff",
      "warm-light": "#e0e0d9",
      "fog": "#f6f6f3",
      "border-disabled": "#c8c8c1",
      "hover-gray": "#bcbcb3",
      "dark-surface": "#33332e",
      "error-red": "#9e0a0a"
    },
    "semantic": {
      "success": "#103c25",
      "danger": "#9e0a0a",
      "info": "#435ee5"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "ui",
        "size": "70px",
        "weight": 600,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "28px",
        "weight": 700,
        "lineHeight": "1.5",
        "letterSpacing": "-1.2px"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "0"
      },
      {
        "role": "Caption Bold",
        "fontKey": "ui",
        "size": "14px",
        "weight": 700,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "6px",
      "s-3": "7px",
      "s-4": "8px",
      "s-5": "10px",
      "s-6": "11px",
      "s-7": "12px",
      "s-8": "16px",
      "s-9": "18px",
      "s-10": "20px",
      "s-11": "22px",
      "s-12": "24px",
      "s-13": "32px",
      "s-14": "80px",
      "s-15": "100px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "20px",
    "lg": "32px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus (Accessibility)",
      "treatment": "--sema-color-border-focus-outer-default ring"
    }
  ],
  "components": {
    "buttonRadius": "20px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
