{
  "version": 1,
  "meta": {
    "id": "raycast",
    "title": "Raycast",
    "category": "Developer Tools",
    "summary": "Productivity launcher. Sleek dark chrome, vibrant gradient accents.",
    "surface": "web"
  },
  "colors": {
    "paper": "#07080a",
    "ink": "#18191a",
    "slate": "#cecece",
    "signal": "#ff6363",
    "bone": "#1b1c1e",
    "border": "#434345",
    "surface": "#101111",
    "extended": {
      "pure-white": "#ffffff",
      "key-start": "#121212",
      "key-end": "#0d0d0d",
      "near-white": "#f9f9f9",
      "silver": "#c0c0c0",
      "medium-gray": "#9c9c9d",
      "dim-gray": "#6a6b6c",
      "dark-border": "#2f3031"
    },
    "semantic": {
      "danger": "#ff6363",
      "info": "#07080a"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "GeistMono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "64px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "0px"
      },
      {
        "role": "Section Display",
        "fontKey": "display",
        "size": "56px",
        "weight": 400,
        "lineHeight": "1.17",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.5",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Card Heading",
        "fontKey": "display",
        "size": "22px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "0px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "20px",
        "weight": 500,
        "lineHeight": "1.60",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.60",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Body Tight",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "0.1px"
      },
      {
        "role": "Button",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.15",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Nav Link",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.40",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.14",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Caption Bold",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.40",
        "letterSpacing": "0px"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "12px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0px"
      },
      {
        "role": "Small Link",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0.4px"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.60",
        "letterSpacing": "0.3px"
      },
      {
        "role": "Code Small",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0.2px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "10px",
    "lg": "20px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "1px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "0px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
