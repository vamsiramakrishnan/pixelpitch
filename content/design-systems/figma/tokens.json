{
  "version": 1,
  "meta": {
    "id": "figma",
    "title": "Figma",
    "category": "Design & Creative",
    "summary": "Collaborative design tool. Vibrant multi-color, playful yet professional.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#111111",
    "slate": "#666666",
    "signal": "#3b82f6",
    "bone": "#f5f5f5",
    "border": "#000000",
    "surface": "#ffffff",
    "extended": {},
    "semantic": {}
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "ui",
        "size": "86px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-1.72px"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "64px",
        "weight": 400,
        "lineHeight": "1.10",
        "letterSpacing": "-0.96px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "ui",
        "size": "26px",
        "weight": 540,
        "lineHeight": "1.35",
        "letterSpacing": "-0.26px"
      },
      {
        "role": "Sub-heading Light",
        "fontKey": "ui",
        "size": "26px",
        "weight": 340,
        "lineHeight": "1.35",
        "letterSpacing": "-0.26px"
      },
      {
        "role": "Feature Title",
        "fontKey": "ui",
        "size": "24px",
        "weight": 700,
        "lineHeight": "1.45",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "20px",
        "weight": 330,
        "lineHeight": "1.30",
        "letterSpacing": "-0.1px"
      },
      {
        "role": "Body / Button",
        "fontKey": "ui",
        "size": "16px",
        "weight": 330,
        "lineHeight": "1.40",
        "letterSpacing": "-0.14px"
      },
      {
        "role": "Body Light",
        "fontKey": "ui",
        "size": "18px",
        "weight": 320,
        "lineHeight": "1.45",
        "letterSpacing": "-0.26px"
      },
      {
        "role": "Mono Label",
        "fontKey": "mono",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "0.54px"
      },
      {
        "role": "Mono Small",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0.6px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "2px",
      "s-3": "4px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "8px",
    "lg": "18px",
    "full": "50px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
