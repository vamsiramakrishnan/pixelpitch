{
  "version": 1,
  "meta": {
    "id": "tesla",
    "title": "Tesla",
    "category": "Automotive",
    "summary": "Electric automotive. Radical subtraction, full-viewport photography, near-zero UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#3e6ae1",
    "ink": "#5c5e62",
    "slate": "#5c5e62",
    "signal": "#3e6ae1",
    "bone": "#f4f4f4",
    "border": "#eeeeee",
    "surface": "#ffffff",
    "extended": {
      "carbon-dark": "#171a20",
      "graphite": "#393c41",
      "silver-fog": "#8e8e8e",
      "pale-silver": "#d0d1d2"
    },
    "semantic": {
      "info": "#3e6ae1"
    }
  },
  "typography": {
    "fontDisplay": "Universal Sans Display",
    "fontBody": "Universal Sans Display",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Hero Title",
        "fontKey": "display",
        "size": "40px",
        "weight": 500,
        "lineHeight": "48",
        "letterSpacing": "0"
      },
      {
        "role": "Product Name",
        "fontKey": "body",
        "size": "17px",
        "weight": 500,
        "lineHeight": "20",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Item",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "16.8",
        "letterSpacing": "0"
      },
      {
        "role": "Body Text",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "20",
        "letterSpacing": "0"
      },
      {
        "role": "Button Label",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "16.8",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-link",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "20",
        "letterSpacing": "0"
      },
      {
        "role": "Promo Text",
        "fontKey": "body",
        "size": "22px",
        "weight": 400,
        "lineHeight": "20",
        "letterSpacing": "0"
      },
      {
        "role": "Category Label",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "16px",
    "lg": "44px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "16px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "16px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
