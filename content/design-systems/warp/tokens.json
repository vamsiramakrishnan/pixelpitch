{
  "version": 1,
  "meta": {
    "id": "warp",
    "title": "Warp",
    "category": "Developer Tools",
    "summary": "Modern terminal. Dark IDE-like interface, block-based command UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#353534",
    "ink": "#faf9f6",
    "slate": "#868584",
    "signal": "#868584",
    "bone": "#666469",
    "border": "#454545",
    "surface": "#faf9f6",
    "extended": {
      "ash-gray": "#afaeac"
    },
    "semantic": {}
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "80px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-2.4px"
      },
      {
        "role": "Section Display",
        "fontKey": "body",
        "size": "56px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-0.56px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "48px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-0.48px"
      },
      {
        "role": "Feature Heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.10",
        "letterSpacing": "-0.4px"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "body",
        "size": "36px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "-0.72px"
      },
      {
        "role": "Card Display",
        "fontKey": "body",
        "size": "42px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "32px",
        "weight": 400,
        "lineHeight": "1.19",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "-0.72px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "22px",
        "weight": 500,
        "lineHeight": "1.14",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.40",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.30",
        "letterSpacing": "-0.18px"
      },
      {
        "role": "Nav/UI",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0px"
      },
      {
        "role": "Button Text",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "1.4px"
      },
      {
        "role": "Small Label",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.35",
        "letterSpacing": "2.4px"
      },
      {
        "role": "Micro",
        "fontKey": "body",
        "size": "11px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0px"
      },
      {
        "role": "Code UI",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "UI Supplement",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "-0.2px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "5px",
    "md": "10px",
    "lg": "18px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "10px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "10px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
