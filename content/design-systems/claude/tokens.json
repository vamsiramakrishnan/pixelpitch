{
  "version": 1,
  "meta": {
    "id": "claude",
    "title": "Claude (Anthropic)",
    "category": "AI & LLM",
    "summary": "Anthropic's AI assistant. Warm terracotta accent, clean editorial layout.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f5f4ed",
    "ink": "#141413",
    "slate": "#5e5d59",
    "signal": "#c96442",
    "bone": "#faf9f5",
    "border": "#30302e",
    "surface": "#faf9f5",
    "extended": {
      "coral-accent": "#d97757",
      "error-crimson": "#b53333",
      "focus-blue": "#3898ec",
      "pure-white": "#ffffff",
      "warm-sand": "#e8e6dc",
      "charcoal-warm": "#4d4c48",
      "stone-gray": "#87867f",
      "dark-warm": "#3d3d3a",
      "warm-silver": "#b0aea5",
      "border-cream": "#f0eee6",
      "ring-warm": "#d1cfc5",
      "ring-subtle": "#dedc01",
      "ring-deep": "#c2c0b6"
    },
    "semantic": {
      "success": "#f5f4ed",
      "warning": "#f5f4ed",
      "danger": "#b53333",
      "info": "#3898ec"
    }
  },
  "typography": {
    "fontDisplay": "Anthropic Serif",
    "fontBody": "Anthropic Serif",
    "fontMono": "Anthropic Mono",
    "ramp": [
      {
        "role": "Display / Hero",
        "fontKey": "display",
        "size": "64px",
        "weight": 500,
        "lineHeight": "1.10",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "52px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "display",
        "size": "36.8px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "display",
        "size": "32px",
        "weight": 500,
        "lineHeight": "1.10",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading Small",
        "fontKey": "display",
        "size": "25.6px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Feature Title",
        "fontKey": "display",
        "size": "20.8px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Body Serif",
        "fontKey": "display",
        "size": "17px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Nav",
        "fontKey": "ui",
        "size": "17px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Body Standard",
        "fontKey": "ui",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body Small",
        "fontKey": "ui",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Label",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.25",
        "letterSpacing": "0.12px"
      },
      {
        "role": "Overline",
        "fontKey": "ui",
        "size": "10px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0.5px"
      },
      {
        "role": "Micro",
        "fontKey": "ui",
        "size": "9.6px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0.096px"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "-0.32px"
      }
