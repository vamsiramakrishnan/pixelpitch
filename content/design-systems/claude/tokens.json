  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "3px",
      "s-2": "4px",
      "s-3": "6px",
      "s-4": "8px",
      "s-5": "10px",
      "s-6": "12px",
      "s-7": "16px",
      "s-8": "20px",
      "s-9": "24px",
      "s-10": "30px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "5px",
    "lg": "120px",
    "full": "32px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "5px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "16px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
