{
  "version": 1,
  "meta": {
    "id": "huggingface",
    "title": "Hugging Face",
    "category": "AI & LLM",
    "summary": "ML community hub. Sunny yellow accent, monospace identity, cheerful and dense.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#374151",
    "slate": "#666666",
    "signal": "#ffd21e",
    "bone": "#fafafa",
    "border": "#e5e7eb",
    "surface": "#ffd21e",
    "extended": {
      "accessible-hf-gold-text": "#917300",
      "hf-yellow-deep": "#f59e0b",
      "hf-yellow-soft": "#fff4cc",
      "canvas-inset": "#f3f4f6",
      "canvas-dark": "#0d1117",
      "ink-muted": "#6b7280",
      "ink-inverse": "#f9fafb",
      "nlp-blue": "#2563eb",
      "vision-green": "#16a34a",
      "audio-purple": "#9333ea",
      "multimodal-pink": "#db2777",
      "tabular-orange": "#ea580c",
      "error": "#dc2626",
      "border-strong": "#d1d5db"
    },
    "semantic": {
      "success": "#16a34a",
      "warning": "#ffd21e",
      "danger": "#dc2626",
      "info": "#2563eb"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display",
        "fontKey": "mono",
        "size": "48px",
        "weight": 600,
        "lineHeight": "1.1",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "H1",
        "fontKey": "mono",
        "size": "32px",
        "weight": 600,
        "lineHeight": "1.2",
        "letterSpacing": "0"
      },
      {
        "role": "H2",
        "fontKey": "mono",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "H3",
        "fontKey": "mono",
        "size": "18px",
        "weight": 600,
        "lineHeight": "1.3",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "ui",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.6",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.4",
        "letterSpacing": "0.01em"
      },
      {
        "role": "Tag / Badge",
        "fontKey": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.2",
        "letterSpacing": "0.02em"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
