{
  "version": 1,
  "meta": {
    "id": "airbnb",
    "title": "Airbnb",
    "category": "E-Commerce & Retail",
    "summary": "Travel marketplace. Warm coral accent, photography-driven, rounded UI.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#ff385c",
    "slate": "#666666",
    "signal": "#ff385c",
    "bone": "#f7f7f7",
    "border": "#dddddd",
    "surface": "#ffffff",
    "extended": {
      "deep-rausch": "#e00b41",
      "plus-magenta": "#92174d",
      "luxe-purple": "#460479",
      "info-blue": "#428bff",
      "ink-black": "#222222",
      "charcoal": "#3f3f3f",
      "ash-gray": "#6a6a6a",
      "mute-gray": "#929292",
      "stone-gray": "#c1c1c1",
      "error-red": "#c13515",
      "deep-error": "#b32505"
    },
    "semantic": {
      "warning": "#c13515",
      "danger": "#c13515",
      "info": "#428bff"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Section Heading",
        "fontKey": "display",
        "size": "28px",
        "weight": 700,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Subsection Heading",
        "fontKey": "display",
        "size": "22px",
        "weight": 500,
        "lineHeight": "1.18",
        "letterSpacing": "-0.44px"
      },
      {
        "role": "Card Title",
        "fontKey": "display",
        "size": "21px",
        "weight": 700,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Listing Title",
        "fontKey": "display",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.20",
        "letterSpacing": "-0.18px"
      },
      {
        "role": "Subtitle Bold",
        "fontKey": "display",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Button Large",
        "fontKey": "ui",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Button Default",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.29",
        "letterSpacing": "0"
      },
      {
        "role": "Link",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Caption Medium",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.29",
        "letterSpacing": "0"
      },
      {
        "role": "Caption Bold",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Caption Small",
        "fontKey": "ui",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.23",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Default",
        "fontKey": "body",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Micro Bold",
        "fontKey": "body",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Badge Uppercase",
        "fontKey": "mono",
        "size": "11px",
        "weight": 600,
        "lineHeight": "1.18",
        "letterSpacing": "0"
      },
      {
        "role": "Superscript",
        "fontKey": "body",
        "size": "8px",
        "weight": 700,
        "lineHeight": "1.25",
        "letterSpacing": "0.32px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "32px",
    "md": "800px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "0",
      "treatment": "No shadow"
    },
    {
      "level": 1,
      "name": "1",
      "treatment": "rgba(0, 0, 0, 0.08) 0 4px 12px"
    },
    {
      "level": 2,
      "name": "2",
      "treatment": "rgba(0, 0, 0, 0.02) 0 0 0 1px, rgba(0, 0, 0, 0.04) 0 2px 6px 0, rgba(0, 0, 0, 0.1) 0 4px 8px 0"
    },
    {
      "level": 3,
      "name": "Focus Ring",
      "treatment": "0 0 0 2px #222222"
    },
    {
      "level": 4,
      "name": "White Separator Ring",
      "treatment": "rgb(255, 255, 255) 0 0 0 4px"
    }
  ],
  "components": {
    "buttonRadius": "800px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "800px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
