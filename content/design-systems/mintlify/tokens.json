{
  "version": 1,
  "meta": {
    "id": "mintlify",
    "title": "Mintlify",
    "category": "Productivity & SaaS",
    "summary": "Documentation platform. Clean, green-accented, reading-optimized.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#0d0d0d",
    "slate": "#333333",
    "signal": "#18e299",
    "bone": "#ffffff",
    "border": "#e5e5e5",
    "surface": "#ffffff",
    "extended": {
      "accessible-mint-text": "#008949",
      "brand-green-light": "#d4fae8",
      "brand-green-deep": "#0fa76e",
      "warm-amber": "#c37d0d",
      "soft-blue": "#3772cf",
      "error-red": "#d45656",
      "gray-500": "#666666",
      "gray-400": "#888888",
      "gray-100": "#f5f5f5",
      "gray-50": "#fafafa"
    },
    "semantic": {
      "success": "#18e299",
      "warning": "#c37d0d",
      "danger": "#d45656",
      "info": "#3772cf"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "Geist Mono",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "body",
        "size": "64px",
        "weight": 600,
        "lineHeight": "1.15",
        "letterSpacing": "-1.28px"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 600,
        "lineHeight": "1.10",
        "letterSpacing": "-0.8px"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "-0.24px"
      },
      {
        "role": "Card Title",
        "fontKey": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.30",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Card Title Light",
        "fontKey": "body",
        "size": "20px",
        "weight": 500,
        "lineHeight": "1.30",
        "letterSpacing": "-0.2px"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Body Medium",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "15px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Link",
        "fontKey": "body",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Label Uppercase",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0.65px"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "-0.26px"
      },
      {
        "role": "Mono Code",
        "fontKey": "mono",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0.6px"
      },
      {
        "role": "Mono Badge",
        "fontKey": "mono",
        "size": "12px",
        "weight": 600,
        "lineHeight": "1.50",
        "letterSpacing": "0.6px"
      },
      {
        "role": "Mono Micro",
        "fontKey": "mono",
        "size": "10px",
        "weight": 500,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "2px",
      "s-2": "4px",
      "s-3": "5px",
      "s-4": "6px",
      "s-5": "7px",
      "s-6": "8px",
      "s-7": "10px",
      "s-8": "12px",
      "s-9": "16px",
      "s-10": "24px",
      "s-11": "32px",
      "s-12": "48px",
      "s-13": "64px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "16px",
    "lg": "96px",
    "full": "9999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Focus Ring (Accessibility)",
      "treatment": "1px solid #18E299 outline"
    }
  ],
  "components": {
    "buttonRadius": "16px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "16px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
