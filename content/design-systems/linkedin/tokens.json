{
  "version": 1,
  "meta": {
    "id": "linkedin",
    "title": "LinkedIn",
    "category": "Productivity & SaaS",
    "summary": "Professional network. Corporate blue, card-based feed, connection-driven design.",
    "surface": "web"
  },
  "colors": {
    "paper": "#f4f2ee",
    "ink": "#0a66c2",
    "slate": "#666666",
    "signal": "#0a66c2",
    "bone": "#ffffff",
    "border": "#e0deda",
    "surface": "#ffffff",
    "extended": {
      "blue-hover": "#004182",
      "blue-light": "#70b5f9",
      "blue-light-dark-mode": "#4b86e7",
      "blue-tint": "#d0e8ff",
      "blue-surface": "#edf3f8",
      "success-green": "#057642",
      "green-light": "#7fc15e",
      "green-surface": "#e7f4e4",
      "warning-orange": "#c37d16",
      "premium-gold": "#f8c77e",
      "error-red": "#cc1016",
      "error-surface": "#fce8e6",
      "border-light": "#ebebeb",
      "surface-hover": "#f5f5f5",
      "surface-active": "#e8e8e8",
      "dark-surface": "#1d2226",
      "open-to-work-green": "#01754f",
      "hiring-frame": "#915907",
      "creator-mode-orange": "#e7700d"
    },
    "semantic": {
      "success": "#057642",
      "warning": "#c37d16",
      "danger": "#cc1016",
      "info": "#0a66c2"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Profile Name",
        "fontKey": "body",
        "size": "24px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Section Title",
        "fontKey": "display",
        "size": "20px",
        "weight": 600,
        "lineHeight": "1.30",
        "letterSpacing": "0"
      },
      {
        "role": "Card Heading",
        "fontKey": "display",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.375",
        "letterSpacing": "0"
      },
      {
        "role": "Body / Feed Text",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Body Semibold",
        "fontKey": "body",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.43",
        "letterSpacing": "0"
      },
      {
        "role": "Caption / Meta",
        "fontKey": "mono",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0.1px"
      },
      {
        "role": "Button Text",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Button Small",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "0"
      },
      {
        "role": "Nav Label",
        "fontKey": "ui",
        "size": "12px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Badge Count",
        "fontKey": "mono",
        "size": "11px",
        "weight": 600,
        "lineHeight": "1.0",
        "letterSpacing": "0"
      },
      {
        "role": "Overline / Pill",
        "fontKey": "ui",
        "size": "12px",
        "weight": 600,
        "lineHeight": "1.33",
        "letterSpacing": "0.4px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "12px",
      "s-4": "16px",
      "s-5": "24px",
      "s-6": "32px",
      "s-7": "48px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "full": "20px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "4px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "16px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
