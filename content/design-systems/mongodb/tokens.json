{
  "version": 1,
  "meta": {
    "id": "mongodb",
    "title": "MongoDB",
    "category": "Backend & Data",
    "summary": "Document database. Green leaf branding, developer documentation focus.",
    "surface": "web"
  },
  "colors": {
    "paper": "#001e2b",
    "ink": "#3c9171",
    "slate": "#5c6c75",
    "signal": "#00ed64",
    "bone": "#e8edeb",
    "border": "#3c9171",
    "surface": "#1c2d38",
    "extended": {
      "action-blue": "#006cfa",
      "hover-blue": "#3860be",
      "teal-active": "#1eaedb",
      "teal-gray": "#3d4f58",
      "dark-slate": "#21313c",
      "silver-teal": "#b8c4c2",
      "pure-white": "#ffffff",
      "black": "#000000"
    },
    "semantic": {
      "success": "#00ed64",
      "info": "#006cfa"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "display",
        "size": "96px",
        "weight": 400,
        "lineHeight": "1.20",
        "letterSpacing": "0"
      },
      {
        "role": "Display Secondary",
        "fontKey": "display",
        "size": "64px",
        "weight": 400,
        "lineHeight": "1.00",
        "letterSpacing": "0"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "36px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Sub-heading",
        "fontKey": "body",
        "size": "24px",
        "weight": 500,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Body Large",
        "fontKey": "body",
        "size": "20px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "18px",
        "weight": 400,
        "lineHeight": "1.33",
        "letterSpacing": "0"
      },
      {
        "role": "Body Light",
        "fontKey": "body",
        "size": "16px",
        "weight": 300,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Nav / UI",
        "fontKey": "body",
        "size": "16px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.16px"
      },
      {
        "role": "Body Bold",
        "fontKey": "body",
        "size": "15px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Button",
        "fontKey": "body",
        "size": "13.5px",
        "weight": 500,
        "lineHeight": "1.00",
        "letterSpacing": "0.135px"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.71",
        "letterSpacing": "0"
      },
      {
        "role": "Small",
        "fontKey": "body",
        "size": "11px",
        "weight": 600,
        "lineHeight": "1.82",
        "letterSpacing": "0.2px"
      },
      {
        "role": "Code Heading",
        "fontKey": "mono",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.60",
        "letterSpacing": "0"
      },
      {
        "role": "Code Body",
        "fontKey": "mono",
        "size": "16px",
        "weight": 400,
        "lineHeight": "1.50",
        "letterSpacing": "0"
      },
      {
        "role": "Code Label",
        "fontKey": "mono",
        "size": "14px",
        "weight": 400,
        "lineHeight": "1.14",
        "letterSpacing": "1px"
      },
      {
        "role": "Code Micro",
        "fontKey": "mono",
        "size": "9px",
        "weight": 600,
        "lineHeight": "2.67",
        "letterSpacing": "2.5px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "1px",
      "s-2": "4px",
      "s-3": "7px",
      "s-4": "8px",
      "s-5": "10px",
      "s-6": "12px",
      "s-7": "14px",
      "s-8": "15px",
      "s-9": "16px",
      "s-10": "18px",
      "s-11": "20px",
      "s-12": "24px",
      "s-13": "32px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "80px",
    "full": "100px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "none"
  }
}
