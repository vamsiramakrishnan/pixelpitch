{
  "version": 1,
  "meta": {
    "id": "arc",
    "title": "Arc Browser",
    "category": "Productivity & SaaS",
    "summary": "\"The browser that browses for you.\" Translucent surfaces, gradient warmth, sidebar-first layout.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#1a1a1f",
    "slate": "#54545a",
    "signal": "#b794f4",
    "bone": "#f5f5f5",
    "border": "#e5e5e5",
    "surface": "#1a1a1f",
    "extended": {
      "sunset-start": "#ff7e5f",
      "sunset-end": "#feb47b",
      "twilight-start": "#7f5af0",
      "twilight-end": "#e84393",
      "aurora-start": "#16f2b3",
      "aurora-end": "#0db4f7",
      "ink-muted": "#8c8c93",
      "ink-inverse": "#fafafa",
      "arc-coral": "#ff5f5f",
      "success": "#48bb78",
      "warning": "#f6ad55",
      "error": "#f56565"
    },
    "semantic": {
      "success": "#48bb78",
      "warning": "#f6ad55",
      "danger": "#f56565"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Marketing Hero",
        "fontKey": "body",
        "size": "72px",
        "weight": 400,
        "lineHeight": "1.05",
        "letterSpacing": "-0.03em"
      },
      {
        "role": "Section Heading",
        "fontKey": "body",
        "size": "40px",
        "weight": 400,
        "lineHeight": "1.15",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "Page H1",
        "fontKey": "body",
        "size": "32px",
        "weight": 700,
        "lineHeight": "1.2",
        "letterSpacing": "-0.02em"
      },
      {
        "role": "Page H2",
        "fontKey": "body",
        "size": "22px",
        "weight": 600,
        "lineHeight": "1.25",
        "letterSpacing": "-0.01em"
      },
      {
        "role": "Tab Title",
        "fontKey": "body",
        "size": "13px",
        "weight": 500,
        "lineHeight": "1.3",
        "letterSpacing": "-0.005em"
      },
      {
        "role": "Body",
        "fontKey": "body",
        "size": "15px",
        "weight": 400,
        "lineHeight": "1.55",
        "letterSpacing": "0"
      },
      {
        "role": "Caption",
        "fontKey": "body",
        "size": "12px",
        "weight": 500,
        "lineHeight": "1.4",
        "letterSpacing": "0.01em"
      },
      {
        "role": "Code",
        "fontKey": "mono",
        "size": "13px",
        "weight": 400,
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "full": "999px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "8px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "8px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
