{
  "version": 1,
  "meta": {
    "id": "superhuman",
    "title": "Superhuman",
    "category": "Developer Tools",
    "summary": "Fast email client. Premium dark UI, keyboard-first, purple glow.",
    "surface": "web"
  },
  "colors": {
    "paper": "#ffffff",
    "ink": "#292827",
    "slate": "#666666",
    "signal": "#cbb7fb",
    "bone": "#e9e5dd",
    "border": "#dcd7d3",
    "surface": "#dcd7d3",
    "extended": {
      "mysteria-purple": "#1b1938",
      "amethyst-link": "#714cb6"
    },
    "semantic": {
      "info": "#1b1938"
    }
  },
  "typography": {
    "fontDisplay": "system-ui, sans-serif",
    "fontBody": "system-ui, sans-serif",
    "fontMono": "ui-monospace, monospace",
    "ramp": [
      {
        "role": "Display Hero",
        "fontKey": "ui",
        "size": "64px",
        "weight": 540,
        "lineHeight": "0.96",
        "letterSpacing": "0px"
      },
      {
        "role": "Section Display",
        "fontKey": "ui",
        "size": "48px",
        "weight": 460,
        "lineHeight": "0.96",
        "letterSpacing": "-1.32px"
      },
      {
        "role": "Section Heading",
        "fontKey": "ui",
        "size": "48px",
        "weight": 460,
        "lineHeight": "0.96",
        "letterSpacing": "0px"
      },
      {
        "role": "Feature Title",
        "fontKey": "ui",
        "size": "28px",
        "weight": 540,
        "lineHeight": "1.14",
        "letterSpacing": "-0.63px"
      },
      {
        "role": "Sub-heading Large",
        "fontKey": "ui",
        "size": "26px",
        "weight": 460,
        "lineHeight": "1.30",
        "letterSpacing": "0px"
      },
      {
        "role": "Card Heading",
        "fontKey": "ui",
        "size": "22px",
        "weight": 460,
        "lineHeight": "0.76",
        "letterSpacing": "-0.315px"
      },
      {
        "role": "Body Heading",
        "fontKey": "ui",
        "size": "20px",
        "weight": 460,
        "lineHeight": "1.20",
        "letterSpacing": "0px"
      },
      {
        "role": "Body Heading Alt",
        "fontKey": "ui",
        "size": "20px",
        "weight": 460,
        "lineHeight": "1.10",
        "letterSpacing": "-0.55px"
      },
      {
        "role": "Body Heading Relaxed",
        "fontKey": "ui",
        "size": "20px",
        "weight": 460,
        "lineHeight": "1.25",
        "letterSpacing": "-0.4px"
      },
      {
        "role": "Emphasis Body",
        "fontKey": "ui",
        "size": "18px",
        "weight": 540,
        "lineHeight": "1.50",
        "letterSpacing": "-0.135px"
      },
      {
        "role": "Body",
        "fontKey": "ui",
        "size": "16px",
        "weight": 460,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Button / UI Bold",
        "fontKey": "ui",
        "size": "16px",
        "weight": 700,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Button / UI Semi",
        "fontKey": "ui",
        "size": "16px",
        "weight": 600,
        "lineHeight": "1.00",
        "letterSpacing": "0px"
      },
      {
        "role": "Nav Link",
        "fontKey": "ui",
        "size": "16px",
        "weight": 460,
        "lineHeight": "1.20",
        "letterSpacing": "0px"
      },
      {
        "role": "Caption",
        "fontKey": "ui",
        "size": "14px",
        "weight": 500,
        "lineHeight": "1.20",
        "letterSpacing": "-0.315px"
      },
      {
        "role": "Caption Semi",
        "fontKey": "ui",
        "size": "14px",
        "weight": 600,
        "lineHeight": "1.29",
        "letterSpacing": "0px"
      },
      {
        "role": "Caption Body",
        "fontKey": "ui",
        "size": "14px",
        "weight": 460,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      },
      {
        "role": "Micro Label",
        "fontKey": "ui",
        "size": "12px",
        "weight": 700,
        "lineHeight": "1.50",
        "letterSpacing": "0px"
      }
    ]
  },
  "spacing": {
    "base": 8,
    "scale": {
      "s-1": "4px",
      "s-2": "8px",
      "s-3": "16px",
      "s-4": "24px",
      "s-5": "32px",
      "s-6": "48px",
      "s-7": "64px",
      "s-8": "96px"
    }
  },
  "radii": {
    "none": "0",
    "sm": "6px",
    "md": "12px",
    "lg": "18px",
    "full": "50px"
  },
  "depth": [
    {
      "level": 0,
      "name": "Flat",
      "treatment": "none"
    },
    {
      "level": 1,
      "name": "Border",
      "treatment": "1px solid var(--border)"
    },
    {
      "level": 2,
      "name": "Elevated",
      "treatment": "0 2px 8px rgba(0,0,0,0.08)"
    }
  ],
  "components": {
    "buttonRadius": "12px",
    "buttonPaddingBlock": "10px",
    "buttonPaddingInline": "20px",
    "cardRadius": "12px",
    "cardBorder": "1px solid var(--border)",
    "cardShadow": "0 2px 8px rgba(0,0,0,0.08)"
  }
}
